---
interface Props {
  title?: string;
  description?: string;
}

// biome-ignore lint/correctness/noUnusedVariables: Astro template expressions consume these props below, but Biome only sees frontmatter scope.
const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title ?? 'Conloca CMS Example'}</title>
    {description && <meta name="description" content={description} />}
  </head>
  <body>
    <slot />
  </body>
</html>
