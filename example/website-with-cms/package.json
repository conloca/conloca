{
  "name": "website-with-cms",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "NODE_OPTIONS='--import=extensionless/register' astro dev",
    "build": "NODE_OPTIONS='--import=extensionless/register' astro build",
    "preview": "NODE_OPTIONS='--import=extensionless/register' astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/react": "^4.3.0",
    "@conloca/astro-cms": "workspace:*",
    "@conloca/content-api": "workspace:*",
    "@astrojs/node": "^8.0.0",
    "@measured/puck": "^0.19.1",
    "astro": "5.12.8",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/bun": "^1.2.17",
    "extensionless": "^1.9.9"
  },
  "nx": {
    "targets": {
      "watch-deps": {
        "executor": "nx:run-commands",
        "options": {
          "command": "nx watch --projects=website-with-cms --includeDependentProjects -- nx run-many -t build -p $NX_PROJECT_NAME --exclude=website-with-cms"
        },
        "continuous": true
      },
      "dev": {
        "continuous": true,
        "dependsOn": [
          "^build"
        ]
      }
    }
  }
}
