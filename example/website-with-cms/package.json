{
  "name": "website-with-cms",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "nx run website-with-cms:dev --tui=false --outputStyle=stream",
    "build": "nx run website-with-cms:build",
    "preview": "nx run website-with-cms:preview --tui=false --outputStyle=stream",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/node": "^10.0.6",
    "@astrojs/react": "^4.4.2",
    "@conloca/astro-cms": "workspace:*",
    "@conloca/content-api": "workspace:*",
    "@conloca/mdx": "workspace:*",
    "@node-rs/xxhash": "^1.7.6",
    "astro": "^6.2.1",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/bun": "1.3.13",
    "@typescript-eslint/parser": "^8.59.1",
    "eslint-plugin-astro": "^1.7.0",
    "extensionless": "^2.0.6"
  },
  "nx": {
    "targets": {
      "watch-deps": {
        "executor": "nx:run-commands",
        "options": {
          "command": "nx watch --projects=website-with-cms --includeDependentProjects -- nx run-many -t build -p $NX_PROJECT_NAME --exclude=website-with-cms"
        },
        "continuous": true
      },
      "dev": {
        "continuous": true,
        "dependsOn": [
          "^build"
        ],
        "executor": "nx:run-commands",
        "options": {
          "command": "astro dev",
          "cwd": "{projectRoot}",
          "env": {
            "NODE_OPTIONS": "--import=extensionless/register"
          }
        }
      },
      "lint": {
        "executor": "nx:run-commands",
        "cache": true,
        "options": {
          "commands": [
            "biome lint --files-ignore-unknown=true .",
            "eslint ."
          ],
          "cwd": "{projectRoot}",
          "parallel": false
        }
      },
      "build": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "^build"
        ],
        "options": {
          "command": "astro build",
          "cwd": "{projectRoot}"
        }
      },
      "preview": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build"
        ],
        "continuous": true,
        "options": {
          "command": "astro preview",
          "cwd": "{projectRoot}",
          "env": {
            "NODE_OPTIONS": "--import=extensionless/register"
          }
        }
      }
    },
    "name": "website-with-cms"
  }
}
