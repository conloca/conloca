{
  "name": "website-with-cms",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "nx run website-with-cms:dev --outputStyle=dynamic-legacy",
    "build": "nx run website-with-cms:build",
    "preview": "nx run website-with-cms:preview --outputStyle=stream",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.5",
    "@astrojs/react": "^6.0.5",
    "@conloca/astro-cms": "workspace:*",
    "@conloca/content-api": "workspace:*",
    "@conloca/mdx": "workspace:*",
    "@node-rs/xxhash": "^1.7.7",
    "@puckeditor/core": "^0.23.0",
    "@vitejs/plugin-react": "^5.2.0",
    "astro": "^7.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typia": "^14.0.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@ttsc/unplugin": "^0.30.4",
    "@types/bun": "1.4.2",
    "extensionless": "^2.0.6",
    "ttsc": "0.30.4"
  },
  "nx": {
    "targets": {
      "clean": {},
      "typecheck": {
        "//": "`astro check` also typechecks .astro templates, which tsc cannot parse; inference only ever derives a tsc program.",
        "executor": "nx:run-commands",
        "cache": true,
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "default",
          "^default"
        ],
        "options": {
          "command": "astro check",
          "cwd": "{projectRoot}"
        }
      },
      "watch-deps": {
        "executor": "nx:run-commands",
        "options": {
          "command": "nx watch --projects=website-with-cms --includeDependentProjects -- nx run-many -t build -p $NX_PROJECT_NAME --exclude=website-with-cms"
        },
        "continuous": true
      },
      "dev": {
        "continuous": true,
        "dependsOn": [
          "^build"
        ],
        "executor": "nx:run-commands",
        "options": {
          "command": "astro dev",
          "cwd": "{projectRoot}",
          "env": {
            "NODE_OPTIONS": "--import=extensionless/register"
          }
        }
      },
      "lint": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "default",
          "^default"
        ],
        "options": {
          "commands": [
            "biome lint --files-ignore-unknown=true .",
            "eslint ."
          ],
          "cwd": "{projectRoot}",
          "parallel": false
        }
      },
      "build": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "^build"
        ],
        "options": {
          "command": "astro build",
          "cwd": "{projectRoot}"
        }
      },
      "preview": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build"
        ],
        "continuous": true,
        "options": {
          "command": "astro preview",
          "cwd": "{projectRoot}",
          "env": {
            "NODE_OPTIONS": "--import=extensionless/register"
          }
        }
      }
    },
    "name": "website-with-cms"
  }
}
