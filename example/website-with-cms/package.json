{
  "name": "website-with-cms",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "NODE_OPTIONS='--import=extensionless/register' astro dev",
    "build": "astro build",
    "preview": "NODE_OPTIONS='--import=extensionless/register' astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/react": "^4.4.1",
    "@conloca/astro-cms": "workspace:*",
    "@conloca/content-api": "workspace:*",
    "@conloca/mdx": "workspace:*",
    "@astrojs/node": "^9.5.0",
    "@node-rs/xxhash": "^1.7.6",
    "astro": "5.15.3",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/bun": "^1.3.1",
    "@typescript-eslint/parser": "^8.46.4",
    "eslint-plugin-astro": "^1.5.0",
    "extensionless": "^2.0.2"
  },
  "nx": {
    "targets": {
      "watch-deps": {
        "executor": "nx:run-commands",
        "options": {
          "command": "nx watch --projects=website-with-cms --includeDependentProjects -- nx run-many -t build -p $NX_PROJECT_NAME --exclude=website-with-cms"
        },
        "continuous": true
      },
      "build": {
        "dependsOn": [
          "^build"
        ]
      },
      "dev": {
        "continuous": true,
        "dependsOn": [
          "^build",
          "watch-deps"
        ]
      }
    }
  }
}
