{
  "name": "conloca-website",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "nx run conloca-website:dev --outputStyle=dynamic-legacy",
    "build": "nx run conloca-website:build",
    "preview": "nx run conloca-website:preview --outputStyle=stream",
    "astro": "astro",
    "deploy": "nx run conloca-website:deploy:production --outputStyle=stream",
    "deploy:dry": "wrangler deploy --env=\"\" --dry-run",
    "db:migrate:local": "wrangler d1 migrations apply DB --local"
  },
  "dependencies": {
    "@astrojs/internal-helpers": "0.8.0",
    "@astrojs/mdx": "^5.0.6",
    "@astrojs/react": "^4.4.2",
    "@astrojs/starlight": "^0.39.0",
    "@astrojs/starlight-tailwind": "^4.0.0",
    "@conloca/astro-cms": "workspace:*",
    "@conloca/cms-spa": "workspace:*",
    "@mdxeditor/editor": "^3.55.0",
    "@node-rs/xxhash": "^1.7.6",
    "@puckeditor/core": "^0.21.2",
    "@tailwindcss/vite": "^4.1.0",
    "acorn": "^8.15.0",
    "astro": "^6.2.1",
    "clsx": "^2.1.1",
    "cookie": "^1.1.1",
    "lucide-react": "^0.564.0",
    "mdast-util-mdx-jsx": "^3.0.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.33.0",
    "tailwindcss": "^4.1.16",
    "zod": "^4.4.1"
  },
  "nx": {
    "targets": {
      "build": {
        "dependsOn": [
          "^build"
        ],
        "executor": "nx:run-commands",
        "options": {
          "command": "astro build",
          "cwd": "{projectRoot}"
        }
      },
      "migrate": {
        "executor": "nx:run-commands",
        "options": {
          "command": "wrangler d1 migrations apply DB --remote --env=\"\"",
          "cwd": "{projectRoot}"
        },
        "configurations": {
          "staging": {
            "command": "wrangler d1 migrations apply DB --remote --env staging"
          }
        }
      },
      "deploy": {
        "dependsOn": [
          "build",
          {
            "target": "migrate",
            "projects": "self",
            "params": "forward"
          }
        ],
        "executor": "nx:run-commands",
        "options": {
          "command": "wrangler deploy --env=\"\"",
          "cwd": "{projectRoot}"
        },
        "configurations": {
          "staging": {
            "command": "wrangler deploy --env staging"
          }
        }
      },
      "dev": {
        "dependsOn": [
          "^build"
        ],
        "executor": "nx:run-commands",
        "continuous": true,
        "options": {
          "command": "astro dev",
          "cwd": "{projectRoot}"
        }
      },
      "preview": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build"
        ],
        "continuous": true,
        "options": {
          "command": "astro preview",
          "cwd": "{projectRoot}"
        }
      },
      "wrangler-types": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "{projectRoot}/wrangler.toml",
          "{projectRoot}/.dev.vars.example"
        ],
        "outputs": [
          "{projectRoot}/worker-configuration.d.ts"
        ],
        "options": {
          "command": "wrangler types --env staging --env-file .dev.vars.example --include-runtime false",
          "cwd": "{projectRoot}"
        }
      }
    },
    "name": "conloca-website"
  },
  "devDependencies": {
    "wrangler": "^4.95.0"
  }
}
