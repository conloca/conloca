{
  "name": "conloca-website",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "nx run conloca-website:dev --outputStyle=stream",
    "build": "nx run conloca-website:build",
    "preview": "nx run conloca-website:preview --outputStyle=stream",
    "astro": "astro",
    "deploy": "bunx wrangler@4.73.0 deploy",
    "deploy:dry": "bunx wrangler@4.73.0 deploy --dry-run",
    "db:migrate:local": "bunx wrangler@4.73.0 d1 migrations apply conloca-website-db --local"
  },
  "dependencies": {
    "@astrojs/internal-helpers": "0.8.0",
    "@astrojs/react": "^4.4.2",
    "@astrojs/starlight": "^0.38.0",
    "@astrojs/starlight-tailwind": "^4.0.0",
    "@conloca/astro-cms": "workspace:*",
    "@node-rs/xxhash": "^1.7.6",
    "@puckeditor/core": "^0.21.2",
    "@tailwindcss/vite": "^4.1.0",
    "astro": "^6.2.1",
    "clsx": "^2.1.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.33.0",
    "tailwindcss": "^4.1.16",
    "zod": "^4.4.1"
  },
  "nx": {
    "targets": {
      "build": {
        "dependsOn": [
          "^build"
        ],
        "executor": "nx:run-commands",
        "options": {
          "command": "astro build",
          "cwd": "{projectRoot}"
        }
      },
      "dev": {
        "dependsOn": [
          "^build"
        ],
        "executor": "nx:run-commands",
        "continuous": true,
        "options": {
          "command": "astro dev",
          "cwd": "{projectRoot}"
        }
      },
      "preview": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build"
        ],
        "continuous": true,
        "options": {
          "command": "astro preview",
          "cwd": "{projectRoot}"
        }
      }
    },
    "name": "conloca-website"
  }
}
