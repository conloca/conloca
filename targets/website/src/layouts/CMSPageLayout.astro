---
import { readFileSync } from 'node:fs'
import { join } from 'node:path'
import Footer from '../components/Footer.astro'
import Navbar from '../components/Navbar.astro'
import { createComparePageSchema, createFAQPageSchema } from '../seo'
import Layout from './Layout.astro'

interface Props {
  title?: string
  description?: string
}

const { title, description } = Astro.props
const pathname = Astro.url.pathname
const isLandingPage = pathname === '/' || pathname === ''

const schemaType = (() => {
  if (isLandingPage) return 'landing'
  if (pathname === '/faq/' || pathname === '/faq') return 'faq'
  if (pathname === '/compare/' || pathname === '/compare') return 'compare'
  if (pathname === '/vxjson/' || pathname === '/vxjson') return 'techArticle'
  return 'page'
})() as 'landing' | 'page' | 'techArticle' | 'faq' | 'compare'

// For StructuredData.astro, map faq/compare to 'page' (extra schemas injected separately in body)
const structuredDataType = schemaType === 'faq' || schemaType === 'compare' ? 'page' : schemaType

let faqItems: { question: string; answer: string }[] | undefined

if (schemaType === 'faq') {
  try {
    const faqPath = join(process.cwd(), 'content/default/pages/faq.en.vxjson')
    const faqData = JSON.parse(readFileSync(faqPath, 'utf-8'))
    const faqComponent = faqData.content?.puckData?.content?.find(
      (c: { type: string }) => c.type === 'FAQ'
    )
    if (faqComponent?.props?.items) {
      faqItems = faqComponent.props.items.map((item: { question: string; answer: string }) => ({
        question: item.question,
        answer: item.answer.replace(/<[^>]*>/g, ''),
      }))
    }
  } catch {
    // FAQ schema will be omitted if file read fails
  }
}
---

<Layout title={title} description={description} schemaType={structuredDataType}>
  <Navbar />
  <main class={isLandingPage ? 'min-h-screen' : 'cms-subpage pt-24 pb-20'}>
    <slot />
  </main>
  <Footer />
  {faqItems && (
    <script type="application/ld+json" set:html={JSON.stringify(createFAQPageSchema(faqItems))} />
  )}
  {schemaType === 'compare' && (
    <script type="application/ld+json" set:html={JSON.stringify(createComparePageSchema({ title: title || '', description: description || '', url: Astro.url.href }))} />
  )}
</Layout>

<style is:global>
  .reveal {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.6s ease-out, transform 0.6s ease-out;
  }
  .reveal.revealed {
    opacity: 1;
    transform: translateY(0);
  }
  /* Tighten prose on subpages — production rendered inline Tailwind, not MDX prose */
  .cms-subpage .mdx-content {
    font-size: 0.875rem;
    line-height: 1.625;
  }
  /* Strip component section padding on CMS subpages (layout provides pt/pb) */
  .cms-subpage > div > section,
  .cms-subpage > div > div {
    padding-top: 0 !important;
    padding-bottom: 0 !important;
  }
  /* Restore inter-section spacing via margin (padding was stripped above).
     Matches live site's mb-20 (80px) on ContentBlockSection elements. */
  .cms-subpage > div > section {
    margin-bottom: 5rem;
  }
  .cms-subpage > div > section:last-child {
    margin-bottom: 0;
  }
  /* Strip inner component wrappers inside narrative sections */
  .narrative-section > section {
    margin: 0 !important;
    padding: 0 !important;
  }
  .narrative-section > section > div {
    max-width: none !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
  }
</style>

<script src="../scripts/animations.ts"></script>
<script src="../scripts/forms.ts"></script>

