---
import Layout from '../layouts/Layout.astro'
import Navbar from '../components/Navbar.astro'
import Footer from '../components/Footer.astro'

const cmsOptions = ['Conloca', 'Storyblok', 'Contentful', 'Decap CMS', 'Tina CMS']

const comparisonRows = [
  {
    feature: 'Pricing',
    values: ['Free / OSS', 'Paid (free tier)', 'Paid (free tier)', 'Free / OSS', 'Free / OSS'],
  },
  {
    feature: 'Storage',
    values: ['Git files', 'Cloud API', 'Cloud API', 'Git files', 'Git files'],
  },
  {
    feature: 'Astro Integration',
    values: ['Native (built for Astro)', 'Plugin', 'Plugin', 'Generic', 'Plugin'],
  },
  {
    feature: 'Visual Editor',
    values: ['Puck drag-and-drop', 'Visual editor', 'Web app', 'Markdown UI', 'Inline editing'],
  },
  {
    feature: 'Database Required',
    values: ['No', 'N/A (hosted)', 'N/A (hosted)', 'No', 'No'],
  },
  {
    feature: 'Self-Hosted',
    values: ['Yes', 'No', 'No', 'Yes', 'Yes (cloud available)'],
  },
  {
    feature: 'Multi-Locale',
    values: ['Built-in', 'Built-in', 'Built-in', 'Built-in', 'Plugin'],
  },
  {
    feature: 'Git Commits',
    values: ['Automatic with attribution', 'No', 'No', 'Yes', 'Yes'],
  },
  {
    feature: 'Component-Based Pages',
    values: ['Yes (Puck blocks)', 'Yes (Storyblok blocks)', 'Yes (content models)', 'No', 'Yes (blocks)'],
  },
  {
    feature: 'Lock-in Risk',
    values: ['None (files in your repo)', 'Medium (API-dependent)', 'High (API-dependent)', 'Low', 'Low'],
  },
]

const differentiators = [
  {
    title: 'No vendor lock-in',
    description:
      'Your content lives in your git repository as plain files. If you stop using Conloca, your content stays exactly where it is. There is no data migration, no export step, and no API to replace. You own your content from day one.',
  },
  {
    title: 'Built for Astro',
    description:
      'Conloca is not a generic CMS bolted onto Astro through a plugin. It is built from the ground up for Astro, using Astro middleware, Astro routing, and Astro build pipelines. This native integration means fewer moving parts and a tighter developer experience.',
  },
  {
    title: 'Visual + Developer',
    description:
      'Marketers and content editors use a visual drag-and-drop editor to build pages. Developers define the components, control the styling, and maintain full ownership of the codebase. Both roles work in the same repository without stepping on each other.',
  },
  {
    title: 'Zero infrastructure',
    description:
      'No database server, no external API, no cloud dependency. Conloca runs as part of your Astro site on Bun or Node.js. Deploy it on a VPS, in a Docker container, or behind a Cloudflare Tunnel. The entire CMS is self-contained.',
  },
]

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Compare Conloca to Other CMS Options',
  description:
    'Side-by-side comparison of Conloca with Storyblok, Contentful, Decap CMS, and Tina CMS for Astro websites.',
  about: {
    '@type': 'SoftwareApplication',
    name: 'Conloca',
  },
  mentions: [
    {
      '@type': 'SoftwareApplication',
      name: 'Storyblok',
      applicationCategory: 'DeveloperApplication',
      applicationSubCategory: 'Content Management System',
      description: 'Cloud-hosted headless CMS with visual editor. Paid with free tier.',
    },
    {
      '@type': 'SoftwareApplication',
      name: 'Contentful',
      applicationCategory: 'DeveloperApplication',
      applicationSubCategory: 'Content Management System',
      description: 'Cloud-hosted API-first headless CMS. Paid with free tier.',
    },
    {
      '@type': 'SoftwareApplication',
      name: 'Decap CMS',
      applicationCategory: 'DeveloperApplication',
      applicationSubCategory: 'Content Management System',
      description: 'Open-source git-based CMS with markdown editing UI.',
    },
    {
      '@type': 'SoftwareApplication',
      name: 'Tina CMS',
      applicationCategory: 'DeveloperApplication',
      applicationSubCategory: 'Content Management System',
      description: 'Open-source git-based CMS with inline visual editing and cloud sync option.',
    },
  ],
}

function getValueStyle(value: string): string {
  const positiveValues = ['Yes', 'Built-in', 'Native', 'Free', 'No', 'None', 'Automatic']
  const isConlocaPositive = positiveValues.some((p) => value.startsWith(p))
  if (isConlocaPositive) return 'text-brand-400'
  return 'text-surface-400'
}
---

<Layout
  title="Compare Conloca to Other CMS Options"
  description="Side-by-side comparison of Conloca with Storyblok, Contentful, Decap CMS, and other content management systems for Astro websites."
  schemaType="page"
>
  <Navbar />
  <main class="pt-24 pb-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <p class="text-brand-400 text-sm font-medium tracking-wide uppercase mb-3">Comparison</p>
        <h1 class="text-3xl sm:text-4xl font-bold text-white mb-4">
          How Conloca Compares
        </h1>
        <p class="text-surface-400 max-w-2xl mx-auto">
          Choosing a CMS for your Astro site? Here's how Conloca compares to popular alternatives.
          Conloca is the only file-based CMS built specifically for Astro with visual drag-and-drop editing
          and full git ownership.
        </p>
        <p class="text-surface-400 text-sm max-w-2xl mx-auto mt-3">
          Conloca is the only CMS that combines file-based git storage, native Astro integration, and visual
          drag-and-drop editing in a single free, open-source package. Unlike cloud-hosted options like Storyblok
          and Contentful, Conloca requires no external API, no database, and no monthly subscription.
        </p>
      </div>

      <div class="mb-20 overflow-x-auto">
        <div class="bg-surface-900/60 border border-surface-800/50 rounded-2xl overflow-hidden min-w-[640px]">
          <table class="w-full">
            <thead>
              <tr class="border-b border-surface-800/60">
                <th scope="col" class="text-left text-sm font-medium text-surface-400 px-6 py-4 w-40">
                  Feature
                </th>
                {cmsOptions.map((cms, i) => (
                  <th
                    scope="col"
                    class:list={[
                      'text-center text-sm font-medium px-4 py-4',
                      i === 0 ? 'text-brand-400' : 'text-surface-400',
                    ]}
                  >
                    {cms}
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              {comparisonRows.map((row, i) => (
                <tr class:list={['border-b border-surface-800/30', { 'bg-surface-800/10': i % 2 === 0 }]}>
                  <th scope="row" class="text-left px-6 py-3.5 text-sm text-surface-300 font-medium">
                    {row.feature}
                  </th>
                  {row.values.map((value, j) => (
                    <td class:list={['px-4 py-3.5 text-center text-sm', j === 0 ? getValueStyle(value) : 'text-surface-400']}>
                      {value}
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <div class="mb-20">
        <div class="text-center mb-12">
          <h2 class="text-2xl sm:text-3xl font-bold text-white mb-4">
            Key Differentiators
          </h2>
          <p class="text-surface-400 max-w-xl mx-auto">
            What makes Conloca different from every other CMS option for Astro.
          </p>
        </div>

        <div class="grid sm:grid-cols-2 gap-6">
          {differentiators.map((item) => (
            <div class="bg-surface-900/40 border border-surface-800/50 rounded-xl p-6">
              <h3 class="text-white font-semibold mb-3 text-sm">{item.title}</h3>
              <p class="text-surface-400 text-sm leading-relaxed">{item.description}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="text-center space-y-4">
        <h2 class="text-2xl font-bold text-white">Ready to try Conloca?</h2>
        <p class="text-surface-400 text-sm max-w-md mx-auto">
          Get started in minutes. Install the package, configure your blocks, and start editing visually.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-2">
          <a
            href="/getting-started/"
            class="inline-flex items-center gap-2 bg-brand-500 hover:bg-brand-400 text-surface-950 font-semibold px-6 py-3 rounded-lg transition-all duration-200 hover:shadow-lg hover:shadow-brand-500/20 text-sm"
          >
            Get Started
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
          <a
            href="/"
            class="inline-flex items-center gap-2 border border-surface-600 hover:border-surface-500 text-surface-300 hover:text-white font-medium px-6 py-3 rounded-lg transition-all duration-200 text-sm"
          >
            Back to Home
          </a>
        </div>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />
