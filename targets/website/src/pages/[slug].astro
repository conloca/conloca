---
import { Render, type Data } from '@puckeditor/core'
import { createContentAPI } from '@conloca/content-api/node'
import CMSPageLayout from '../layouts/CMSPageLayout.astro'
import puckConfig from '../puck.config'

function toSegments(pathname: string) {
  return pathname.split('/').filter(Boolean)
}

export async function getStaticPaths() {
  const api = await createContentAPI({ contentRoot: './content' })
  const site = api.getSite('default')
  const manifests = site ? Array.from(site.listContent({ collection: 'pages', locales: ['en'] })) : []
  const reservedRootSlugs = new Set([
    '__cms',
    'compare',
    'concepts',
    'faq',
    'getting-started',
    'guides',
    'packages',
    'reference',
    'vxjson',
  ])

  return manifests
    .filter((manifest) => {
      const pathname = manifest.locales.en?.pathname

      if (typeof pathname !== 'string') {
        return false
      }

      const segments = pathname.split('/').filter(Boolean)

      return segments.length === 1 && !reservedRootSlugs.has(segments[0])
    })
    .map((manifest) => ({
      params: { slug: manifest.locales.en?.pathname?.split('/').filter(Boolean)[0] },
      props: { pageId: manifest.id },
    }))
}

const api = await createContentAPI({ contentRoot: './content' })
const { pageId } = Astro.props as { pageId: string }
const page = await api.getLocalized(pageId, 'en')
const title = page?.localized.meta.title || 'Page'
const description = typeof page?.localized.meta.description === 'string' ? page.localized.meta.description : undefined
const puckData = page?.localized.content.puckData as Data | undefined
---

<CMSPageLayout title={title} description={description}>
  {puckData ? (
    <Render config={puckConfig} data={puckData} />
  ) : (
    <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
      <div class="rounded-2xl border border-surface-200/80 bg-surface-100/60 p-8 text-center dark:border-surface-800/50 dark:bg-surface-900/40">
        <h1 class="text-2xl font-semibold text-surface-900 dark:text-white">This page is empty</h1>
        <p class="mt-3 text-surface-500 dark:text-surface-400">
          Add content to this page in Conloca CMS and refresh the site preview.
        </p>
      </div>
    </section>
  )}
</CMSPageLayout>
