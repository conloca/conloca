---
interface Props {
  type?: 'landing' | 'page'
}

const { type = 'page' } = Astro.props

const organization = {
  '@type': 'Organization',
  name: 'Conloca',
  url: 'https://conloca.com',
  logo: 'https://conloca.com/favicon.svg',
  sameAs: ['https://github.com/conloca/conloca'],
}

const softwareApplication = {
  '@type': 'SoftwareApplication',
  name: 'Conloca',
  alternateName: ['Conloca CMS'],
  applicationCategory: 'DeveloperApplication',
  applicationSubCategory: 'Content Management System',
  operatingSystem: 'Cross-platform',
  description:
    'Conloca is a free, open-source, file-based content management system built specifically for Astro websites. It stores all content as version-controlled files in your git repository with visual drag-and-drop editing powered by Puck.',
  keywords:
    'CMS for Astro, file-based CMS, git-based CMS, visual editor, drag-and-drop CMS, open source CMS, Storyblok alternative, Contentful alternative',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
    description: 'Free and open source under the MIT License',
  },
  featureList: [
    'File-based storage with VXJSON format',
    'Visual drag-and-drop editor powered by Puck',
    'Git-native version control with author attribution',
    'Built-in multi-locale content management',
    'MDX support for rich content',
    'Self-hosted deployment on Bun or Node.js',
    'Cloudflare Access authentication',
    'Config-driven routing',
  ],
  license: 'https://opensource.org/licenses/MIT',
}

const howTo = {
  '@type': 'HowTo',
  name: 'How to Add a Visual CMS to an Astro Website',
  description:
    'Install and configure Conloca CMS in your Astro project to get visual drag-and-drop editing with git-based content storage.',
  totalTime: 'PT15M',
  step: [
    {
      '@type': 'HowToStep',
      position: 1,
      name: 'Install',
      text: 'Add the Conloca CMS package: bun add @conloca/astro-cms @conloca/content-api',
    },
    {
      '@type': 'HowToStep',
      position: 2,
      name: 'Configure',
      text: 'Add conlocaCMS() to your astro.config.mjs integrations array with contentRoot and puckConfigPath options.',
    },
    {
      '@type': 'HowToStep',
      position: 3,
      name: 'Define Components',
      text: 'Create Puck components (blocks) with fields and render functions that editors will use to build pages.',
    },
    {
      '@type': 'HowToStep',
      position: 4,
      name: 'Start Editing',
      text: 'Run bun run dev and navigate to /__cms to start creating pages visually.',
    },
  ],
}

const webSite = {
  '@type': 'WebSite',
  name: 'Conloca',
  url: 'https://conloca.com',
  description: 'The file-based CMS that lives in your git repo. Visual editing for Astro websites.',
}

const landingSchema = {
  '@context': 'https://schema.org',
  '@graph': [organization, softwareApplication, webSite, howTo],
}

const pageSchema = {
  '@context': 'https://schema.org',
  '@graph': [organization],
}

const schema = type === 'landing' ? landingSchema : pageSchema
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
