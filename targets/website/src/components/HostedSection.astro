---
const comparisonRows = [
  { feature: 'Visual editor', oss: true, hosted: true },
  { feature: 'File-based storage', oss: true, hosted: true },
  { feature: 'Git commits', oss: true, hosted: true },
  { feature: 'Multi-locale', oss: true, hosted: true },
  { feature: 'Authentication', oss: 'Self-managed', hosted: true },
  { feature: 'Hosting & deploy', oss: 'Self-managed', hosted: true },
  { feature: 'Team management', oss: false, hosted: true },
  { feature: 'Auto-updates', oss: false, hosted: true },
  { feature: 'Support', oss: 'Community', hosted: 'Priority' },
];
---

<section id="cloud" class="py-24 sm:py-32 relative overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-b from-surface-50 dark:from-surface-950 via-surface-100/50 dark:via-surface-900/50 to-surface-50 dark:to-surface-950"></div>
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_bottom,rgba(6,182,212,0.03)_0%,transparent_60%)] dark:bg-[radial-gradient(ellipse_at_bottom,rgba(6,182,212,0.06)_0%,transparent_60%)]"></div>

  <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <span class="inline-flex items-center gap-2 border border-brand-500/30 bg-brand-500/5 rounded-full px-4 py-1.5 text-xs text-brand-400 font-medium mb-6">
        Coming Soon
      </span>
      <h2 class="text-3xl sm:text-4xl font-bold text-surface-900 dark:text-white mb-4">
        Conloca Cloud &mdash; visual editing without the setup
      </h2>
      <p class="text-surface-500 dark:text-surface-400 max-w-2xl mx-auto">
        All the power of Conloca, fully managed. Your team edits visually while you keep full git ownership.
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-6 mb-16">
      <div class="reveal bg-surface-100/60 dark:bg-surface-900/60 border border-surface-200/80 dark:border-surface-800/50 border-dashed rounded-xl aspect-video flex items-center justify-center">
        <div class="text-center">
          <svg class="w-10 h-10 text-surface-600 mx-auto mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <p class="text-surface-500 text-sm font-medium">Screenshot: Visual editor</p>
        </div>
      </div>
      <div class="reveal bg-surface-100/60 dark:bg-surface-900/60 border border-surface-200/80 dark:border-surface-800/50 border-dashed rounded-xl aspect-video flex items-center justify-center">
        <div class="text-center">
          <svg class="w-10 h-10 text-surface-600 mx-auto mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <p class="text-surface-500 text-sm font-medium">Screenshot: Git commit by marketer</p>
        </div>
      </div>
    </div>

    <div class="reveal max-w-3xl mx-auto mb-16">
      <div class="bg-surface-100/60 dark:bg-surface-900/60 border border-surface-200/80 dark:border-surface-800/50 rounded-2xl overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead>
              <tr class="border-b border-surface-200/80 dark:border-surface-800/60">
                <th class="text-left text-sm font-medium text-surface-500 dark:text-surface-400 px-6 py-4">Feature</th>
                <th class="text-center text-sm font-medium text-surface-500 dark:text-surface-400 px-6 py-4">Open Source</th>
                <th class="text-center text-sm font-medium px-6 py-4">
                  <span class="text-brand-400">Hosted</span>
                  <span class="text-surface-500 text-xs ml-1">(Coming Soon)</span>
                </th>
              </tr>
            </thead>
            <tbody>
              {comparisonRows.map((row, i) => (
                <tr class:list={['border-b border-surface-200/30 dark:border-surface-800/30', { 'bg-surface-200/30 dark:bg-surface-800/10': i % 2 === 0 }]}>
                  <td class="px-6 py-3.5 text-sm text-surface-600 dark:text-surface-300">{row.feature}</td>
                  <td class="px-6 py-3.5 text-center">
                    {row.oss === true ? (
                      <svg class="w-5 h-5 text-brand-400 mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                      </svg>
                    ) : row.oss === false ? (
                      <svg class="w-5 h-5 text-surface-600 mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M18 12H6" />
                      </svg>
                    ) : (
                      <span class="text-xs text-surface-500">{row.oss}</span>
                    )}
                  </td>
                  <td class="px-6 py-3.5 text-center">
                    {row.hosted === true ? (
                      <svg class="w-5 h-5 text-brand-400 mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                      </svg>
                    ) : (
                      <span class="text-xs text-brand-300">{row.hosted}</span>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <div id="waitlist" class="reveal max-w-md mx-auto text-center">
      <h3 class="text-xl font-semibold text-surface-900 dark:text-white mb-2">Get early access</h3>
      <p class="text-surface-500 dark:text-surface-400 text-sm mb-6">Be first to know when Conloca Cloud launches.</p>
      <form id="waitlist-form" class="flex flex-col sm:flex-row gap-3">
        <input type="hidden" name="intent" value="hosted" />
        <input
          type="email"
          name="email"
          required
          placeholder="you@company.com"
          autocomplete="email"
          aria-label="Email address for waitlist"
          class="flex-1 bg-surface-100 dark:bg-surface-800/60 border border-surface-300 dark:border-surface-700/60 rounded-lg px-4 py-3 text-sm text-surface-900 dark:text-white placeholder:text-surface-400 dark:placeholder:text-surface-500 focus:outline-none focus:ring-2 focus:ring-brand-500/40 focus:border-brand-500/60 transition-all"
        />
        <button
          type="submit"
          class="bg-brand-500 hover:bg-brand-400 text-surface-950 font-semibold px-6 py-3 rounded-lg transition-all duration-200 text-sm whitespace-nowrap hover:shadow-lg hover:shadow-brand-500/20"
        >
          Join Waitlist
        </button>
      </form>
      <p id="waitlist-msg" class="mt-3 text-sm hidden"></p>
    </div>
  </div>
</section>
