---
const links = [
  { label: 'Docs', href: '/getting-started/' },
  { label: 'Quick Start', href: '#quickstart' },
  { label: 'Features', href: '#features' },
  { label: 'Cloud', href: '#cloud' },
  { label: 'FAQ', href: '/faq/' },
  { label: 'Compare', href: '/compare/' },
  { label: 'GitHub', href: 'https://github.com/conloca/conloca', external: true },
];
---

<nav
  id="navbar"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <a href="/" class="flex items-center gap-2 group">
        <div class="w-8 h-8 rounded-lg bg-brand-500 flex items-center justify-center text-white font-bold text-sm transition-transform group-hover:scale-110">
          C
        </div>
        <span class="text-white font-semibold text-lg tracking-tight">Conloca</span>
      </a>

      <div class="hidden md:flex items-center gap-8">
        {links.map((link) => (
          <a
            href={link.href}
            class="text-sm text-surface-400 hover:text-white transition-colors duration-200"
            {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
          >
            {link.label}
            {link.external && (
              <svg class="inline-block w-3 h-3 ml-1 -mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            )}
          </a>
        ))}
      </div>

      <button
        id="mobile-menu-btn"
        class="md:hidden text-surface-400 hover:text-white transition-colors p-2"
        aria-label="Toggle menu"
      >
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path id="menu-icon" stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="md:hidden hidden border-t border-surface-800/50 bg-surface-950/95 backdrop-blur-xl"
  >
    <div class="px-4 py-4 space-y-3">
      {links.map((link) => (
        <a
          href={link.href}
          class="block text-sm text-surface-400 hover:text-white transition-colors py-2"
          {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
        >
          {link.label}
        </a>
      ))}
    </div>
  </div>
</nav>

<div
  id="mobile-menu-backdrop"
  class="fixed inset-0 z-40 bg-surface-950/60 backdrop-blur-sm hidden md:hidden"
></div>

<script>
  const navbar = document.getElementById('navbar');
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const backdrop = document.getElementById('mobile-menu-backdrop');

  let menuOpen = false;

  function toggleMenu(open: boolean) {
    menuOpen = open;
    menu?.classList.toggle('hidden', !menuOpen);
    backdrop?.classList.toggle('hidden', !menuOpen);
    document.body.classList.toggle('overflow-hidden', menuOpen);
  }

  btn?.addEventListener('click', () => {
    toggleMenu(!menuOpen);
  });

  backdrop?.addEventListener('click', () => {
    toggleMenu(false);
  });

  menu?.querySelectorAll('a').forEach((a) => {
    a.addEventListener('click', () => {
      toggleMenu(false);
    });
  });

  window.addEventListener('scroll', () => {
    if (window.scrollY > 20) {
      navbar?.classList.add('bg-surface-950/80', 'backdrop-blur-xl', 'border-b', 'border-surface-800/50');
    } else {
      navbar?.classList.remove('bg-surface-950/80', 'backdrop-blur-xl', 'border-b', 'border-surface-800/50');
    }
  });
</script>
