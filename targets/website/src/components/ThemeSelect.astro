---
/**
 * Custom Starlight ThemeSelect override.
 * Replaces the default dropdown with the same sun/moon toggle used on the landing page.
 */
---

<button
  id="starlight-theme-toggle"
  class="sl-theme-toggle"
  aria-label="Toggle theme"
>
  <svg id="sl-theme-icon-sun" class="sl-theme-icon hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
    <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
  </svg>
  <svg id="sl-theme-icon-moon" class="sl-theme-icon hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
    <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
  </svg>
</button>

<style>
  .sl-theme-toggle {
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    color: var(--sl-color-gray-2);
    transition: color 0.2s;
  }
  .sl-theme-toggle:hover {
    color: var(--sl-color-white);
  }
  .sl-theme-icon {
    width: 1.25rem;
    height: 1.25rem;
  }
  .hidden {
    display: none;
  }
</style>

<script is:inline>
  function initStarlightToggle() {
    const sunIcon = document.getElementById('sl-theme-icon-sun')
    const moonIcon = document.getElementById('sl-theme-icon-moon')
    const btn = document.getElementById('starlight-theme-toggle')

    function updateIcons(theme) {
      if (theme === 'dark') {
        sunIcon?.classList.remove('hidden')
        moonIcon?.classList.add('hidden')
      } else {
        sunIcon?.classList.add('hidden')
        moonIcon?.classList.remove('hidden')
      }
    }

    if (!btn) {
      updateIcons(document.documentElement.dataset.theme || 'dark')
      return
    }

    if (btn.dataset.bound === 'true') {
      updateIcons(document.documentElement.dataset.theme || 'dark')
      return
    }

    function toggleTheme() {
      const current = document.documentElement.dataset.theme || 'dark'
      const next = current === 'dark' ? 'light' : 'dark'
      document.documentElement.dataset.theme = next
      localStorage.setItem('starlight-theme', next)
      updateIcons(next)
    }

    btn.dataset.bound = 'true'
    btn?.addEventListener('click', toggleTheme)
    updateIcons(document.documentElement.dataset.theme || 'dark')
  }

  initStarlightToggle()
  document.addEventListener('astro:after-swap', initStarlightToggle)
</script>
