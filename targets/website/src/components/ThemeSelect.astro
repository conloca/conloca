---
/**
 * Custom Starlight ThemeSelect override.
 * Replaces the default dropdown with the same sun/moon toggle used on the landing page.
 */
---

<button class="sl-theme-toggle" aria-label="Toggle theme">
  <svg class="sl-theme-icon hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
    <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
  </svg>
  <svg class="sl-theme-icon hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
    <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
  </svg>
</button>

<style>
  .sl-theme-toggle {
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    color: var(--sl-color-gray-2);
    transition: color 0.2s;
  }
  .sl-theme-toggle:hover {
    color: var(--sl-color-white);
  }
  .sl-theme-icon {
    width: 1.25rem;
    height: 1.25rem;
  }
  .hidden {
    display: none;
  }
</style>

<script is:inline>
  function initStarlightToggle() {
    function updateIcons(theme) {
      document.querySelectorAll('.sl-theme-toggle').forEach(function(toggle) {
        var sun = toggle.querySelector('.sl-theme-icon:first-of-type')
        var moon = toggle.querySelector('.sl-theme-icon:last-of-type')
        if (theme === 'dark') {
          sun?.classList.remove('hidden')
          moon?.classList.add('hidden')
        } else {
          sun?.classList.add('hidden')
          moon?.classList.remove('hidden')
        }
      })
    }

    document.querySelectorAll('.sl-theme-toggle').forEach(function(btn) {
      if (btn.dataset.bound === 'true') return
      btn.dataset.bound = 'true'
      btn.addEventListener('click', function() {
        var current = document.documentElement.dataset.theme || 'dark'
        var next = current === 'dark' ? 'light' : 'dark'
        document.documentElement.dataset.theme = next
        localStorage.setItem('starlight-theme', next)
        updateIcons(next)
      })
    })

    updateIcons(document.documentElement.dataset.theme || 'dark')
  }

  initStarlightToggle()
  document.addEventListener('astro:after-swap', initStarlightToggle)
</script>
