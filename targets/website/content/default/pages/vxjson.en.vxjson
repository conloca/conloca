{"created":"2026-03-30T00:00:00.000Z","id":"vx-vxjs0nex","meta":{"title":"VxJSON -- Content Storage Format","description":"VxJSON stores CMS content as git-friendly JSON files with content-last field ordering for 4KB-optimized metadata indexing and deterministic ETags."},"modified":"2026-03-30T00:00:00.000Z","type":"puck","content":{"puckData":{"content":[{"type":"Hero","props":{"id":"Hero-y5z6a7b8","badgeText":"STORAGE FORMAT","title":"VxJSON","description":"Conloca's git-friendly content storage format. Standard JSON with content-last field ordering for fast metadata indexing and deterministic ETags.","buttons":[]}},{"type":"ContentBlockSection","props":{"id":"ContentBlockSection-c9d0e1f2","label":"Overview","blockId":"vx-wh4t1svxj","width":"default","tone":"transparent"}},{"type":"CodeBlock","props":{"id":"CodeBlock-g3h4i5j6","filename":"home.vxjson","code":"{\n  // Metadata -- fits in first 4KB\n  \"id\": \"abc123\",\n  \"type\": \"puck\",\n  \"created\": \"2026-01-15T10:00:00Z\",\n  \"modified\": \"2026-01-20T14:30:00Z\",\n  \"meta\": {\n    \"title\": \"About Us\",\n    \"description\": \"Learn about our team\"\n  },\n\n  // Content payload -- always last\n  \"content\": {\n    \"puckData\": { ... }\n  }\n}","accentColor":"","legendItems":[{"id":"legend-1","color":"#06b6d4","label":"Metadata (first 4KB)"},{"id":"legend-2","color":"#a855f7","label":"Content payload"}]}},{"type":"ContentBlockSection","props":{"id":"ContentBlockSection-k7l8m9n0","label":"Performance","blockId":"vx-whyc0nt3nt","width":"default","tone":"transparent"}},{"type":"FeatureCards","props":{"id":"FeatureCards-o1p2q3r4","label":"","title":"","subtitle":"","columns":"2","cards":[{"id":"card-4k","iconSvgPath":"","title":"4KB Index Reads","description":"The system can index thousands of pages by reading only the first 4KB of each file. Metadata like title, dates, and ETags are always there -- no need to parse the full content payload.","iconText":"4K"},{"id":"card-etag","iconSvgPath":"M7.5 21L3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5","title":"Independent ETags","description":"The dual metaEtag.contentEtag format lets the system detect staleness for metadata and content independently -- critical for content inheritance across locales."}]}},{"type":"ContentBlockSection","props":{"id":"ContentBlockSection-s5t6u7v8","label":"Reliability","blockId":"vx-cr4shs4f3","width":"default","tone":"transparent"}},{"type":"NumberedFlow","props":{"id":"NumberedFlow-w9x0y1z2","title":"","subtitle":"","items":[{"id":"flow-1","number":"1","title":"Write to temp file","description":"Content is written to a temporary file with a unique name: `{path}.tmp.{pid}.{hrtime}`"},{"id":"flow-2","number":"2","title":"Atomic rename","description":"`rename()` replaces the target file in a single operation. On POSIX systems, this is guaranteed atomic -- the file is either fully old or fully new."},{"id":"flow-3","number":"3","title":"Crash recovery","description":"If the process crashes during step 1, only the temp file is left behind -- the original is untouched. If it crashes during step 2, the rename either completed or it didn't. No half-written files, ever."}]}},{"type":"ContentBlockSection","props":{"id":"ContentBlockSection-a3b4c5d6","label":"Concurrency","blockId":"vx-3t4gc0ncur","width":"default","tone":"transparent"}},{"type":"CodeBlock","props":{"id":"CodeBlock-e7f8g9h0","filename":"","code":"metaEtag.contentEtag // e.g. a3f2c1.b7e4d9","accentColor":"","legendItems":[]}},{"type":"ContentBlockSection","props":{"id":"ContentBlockSection-i1j2k3l4","label":"","blockId":"vx-st4l3wr1t3","width":"default","tone":"transparent"}},{"type":"CTABanner","props":{"id":"CTABanner-m5n6o7p8","badgeText":"","title":"See it in action","subtitle":"Get started with Conloca and see how VxJSON keeps your content safe, versioned, and git-friendly.","buttons":[{"id":"btn-vx-1","label":"Get Started","href":"/getting-started/","variant":"primary"},{"id":"btn-vx-2","label":"Back to Home","href":"/","variant":"secondary"}]}}],"root":{"props":{}}}}}