{
  "name": "@conloca/mdx",
  "version": "0.1.12",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/conloca/private",
    "directory": "packages/mdx"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@mdxeditor/editor": "^3.52.3",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.564.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.0",
    "remark-mdx-frontmatter": "^5.2.0",
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@happy-dom/global-registrator": "^20.6.1",
    "happy-dom": "^20.0.10",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.mjs",
      "default": "./dist/node.mjs"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "tsc-bun-test",
    "test:watch": "bun test --watch"
  },
  "nx": {
    "targets": {
      "test": {
        "dependsOn": [
          "^build"
        ]
      }
    }
  },
  "type": "module",
  "types": "./dist/index.d.ts"
}
