{
  "name": "@conloca/mdx",
  "version": "0.1.15",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conloca/conloca.git",
    "directory": "packages/mdx"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "dependencies": {
    "@conloca/content-api": "workspace:*",
    "@mdx-js/mdx": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@mdxeditor/editor": "^3.55.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.564.0",
    "mdast-util-to-markdown": "^2.1.2",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.0",
    "remark-mdx-frontmatter": "^5.2.0",
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "20.6.1",
    "@testing-library/react": "^16.3.2",
    "@tsdown/css": "^0.22.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "happy-dom": "20.6.1",
    "mdast-util-from-markdown": "^2.0.0",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./node": {
      "types": "./dist/node.d.mts",
      "import": "./dist/node.mjs",
      "default": "./dist/node.mjs"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "test": "nx run mdx:test --outputStyle=stream"
  },
  "nx": {
    "targets": {
      "test": {
        "dependsOn": [
          "typecheck-tests",
          "^build"
        ],
        "executor": "@smoothbricks/nx-plugin:bounded-exec",
        "options": {
          "command": "bun --conditions=production test",
          "cwd": "{projectRoot}",
          "timeoutMs": 120000,
          "killAfterMs": 10000
        }
      },
      "lint": {},
      "tsdown-js": {
        "executor": "nx:run-commands",
        "cache": true,
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "{projectRoot}/src/**/*",
          "{projectRoot}/tsdown.config.ts",
          "{projectRoot}/tsconfig.lib.json",
          "{projectRoot}/package.json"
        ],
        "outputs": [
          "{projectRoot}/dist/**/*.mjs",
          "{projectRoot}/dist/**/*.d.mts"
        ],
        "options": {
          "command": "tsdown",
          "cwd": "{projectRoot}"
        }
      }
    },
    "tags": [
      "npm:public"
    ],
    "name": "mdx"
  },
  "type": "module",
  "types": "./dist/index.d.mts",
  "license": "FSL-1.1-ALv2"
}
