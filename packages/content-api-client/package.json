{
  "name": "@conloca/content-api-client",
  "version": "0.1.17-next.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conloca/conloca.git",
    "directory": "packages/content-api-client"
  },
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./testing": {
      "types": "./dist/testing.d.mts",
      "import": "./dist/testing.mjs",
      "default": "./dist/testing.mjs"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo",
    "!dist/test"
  ],
  "scripts": {
    "test": "nx run content-api-client:test --outputStyle=stream"
  },
  "dependencies": {
    "@conloca/content-api": "workspace:*",
    "@tanstack/react-query": "^5.100.6",
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "20.6.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "19.2.14"
  },
  "nx": {
    "targets": {
      "clean": {},
      "lint": {},
      "tsdown-js": {
        "executor": "nx:run-commands",
        "cache": true,
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "{projectRoot}/src/**/*",
          "{projectRoot}/tsdown.config.ts",
          "{projectRoot}/tsconfig.lib.json",
          "{projectRoot}/package.json"
        ],
        "outputs": [
          "{projectRoot}/dist/**/*.mjs",
          "{projectRoot}/dist/**/*.js",
          "{projectRoot}/dist/**/*.d.mts"
        ],
        "options": {
          "command": "tsdown",
          "cwd": "{projectRoot}"
        }
      },
      "test": {
        "executor": "@smoothbricks/nx-plugin:bounded-exec",
        "dependsOn": [
          "typecheck-tests",
          "^build"
        ],
        "options": {
          "command": "bun test --timeout=30000",
          "cwd": "{projectRoot}",
          "timeoutMs": 120000,
          "killAfterMs": 10000
        }
      }
    },
    "tags": [
      "npm:public"
    ],
    "name": "content-api-client"
  },
  "license": "FSL-1.1-ALv2"
}
