{
  "name": "@conloca/content-api-client",
  "version": "0.2.2-next.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conloca/conloca.git",
    "directory": "packages/content-api-client"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "test": "nx run content-api-client:test --outputStyle=stream"
  },
  "dependencies": {
    "@conloca/content-api": "workspace:*",
    "@tanstack/react-query": "^5.102.8",
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "21.0.4",
    "@testing-library/react": "^16.3.3",
    "@types/react": "19.2.18"
  },
  "nx": {
    "targets": {
      "clean": {},
      "lint": {},
      "test": {
        "executor": "@smoothbricks/nx-plugin:bounded-exec",
        "dependsOn": [
          "typecheck-tests",
          "^build",
          "test-packed"
        ],
        "options": {
          "command": "bun test --timeout=0",
          "cwd": "{projectRoot}",
          "idleTimeoutMs": 180000,
          "killAfterMs": 10000
        }
      },
      "test-packed": {
        "//": "The packed shape is a function of the built outputs, the manifest and the locked dependency closure; cached on exactly those.",
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          {
            "dependentTasksOutputFiles": "**/*",
            "transitive": true
          },
          "{projectRoot}/package.json",
          "{workspaceRoot}/bun.lock",
          "{workspaceRoot}/tooling/packaging/**/*"
        ],
        "dependsOn": [
          "build",
          "^build"
        ],
        "options": {
          "command": "bun tooling/packaging/test-packed.ts content-api-client",
          "cwd": "{workspaceRoot}"
        }
      }
    },
    "tags": [
      "npm:public"
    ],
    "name": "content-api-client"
  },
  "license": "FSL-1.1-ALv2"
}
