{
  "name": "@conloca/content-api-client",
  "version": "0.1.9",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/conloca/private",
    "directory": "packages/content-api-client"
  },
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.mjs",
      "default": "./dist/testing.mjs"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo",
    "!dist/test"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "tsc-bun-test"
  },
  "dependencies": {
    "@conloca/content-api": "workspace:*",
    "@tanstack/react-query": "^5.90.21",
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.6.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "19.2.14"
  }
}
