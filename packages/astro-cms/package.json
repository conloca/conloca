{
  "name": "@conloca/astro-cms",
  "version": "0.2.4-next.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conloca/conloca.git",
    "directory": "packages/astro-cms"
  },
  "type": "module",
  "main": "./dist/ts/src/index.js",
  "module": "./dist/ts/src/index.js",
  "types": "./dist/ts/src/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/ts/src/index.d.ts",
      "import": "./dist/ts/src/index.js",
      "default": "./dist/ts/src/index.js"
    },
    "./node": {
      "types": "./dist/ts/node/index.d.ts",
      "import": "./dist/ts/node/index.js",
      "default": "./dist/ts/node/index.js"
    },
    "./node/content": {
      "types": "./dist/ts/node/content.d.ts",
      "import": "./dist/ts/node/content.js",
      "default": "./dist/ts/node/content.js"
    },
    "./cms-handler": {
      "types": "./dist/ts/src/cms-handler.d.ts",
      "import": "./dist/ts/src/cms-handler.js",
      "default": "./dist/ts/src/cms-handler.js"
    },
    "./checks": {
      "types": "./dist/ts/src/checks.d.ts",
      "import": "./dist/ts/src/checks.js",
      "default": "./dist/ts/src/checks.js"
    },
    "./collections": {
      "types": "./dist/ts/src/collections.d.ts",
      "import": "./dist/ts/src/collections.js",
      "default": "./dist/ts/src/collections.js"
    },
    "./page-feed": {
      "types": "./dist/ts/src/page-feed.d.ts",
      "import": "./dist/ts/src/page-feed.js",
      "default": "./dist/ts/src/page-feed.js"
    },
    "./page-schemas": {
      "types": "./dist/ts/src/page-schemas.d.ts",
      "import": "./dist/ts/src/page-schemas.js",
      "default": "./dist/ts/src/page-schemas.js"
    },
    "./puck-manifest": {
      "types": "./dist/ts/src/puck-manifest/index.d.ts",
      "import": "./dist/ts/src/puck-manifest/index.js",
      "default": "./dist/ts/src/puck-manifest/index.js"
    },
    "./components": {
      "types": "./dist/ts/src/components.d.ts",
      "import": "./dist/ts/src/components.js",
      "default": "./dist/ts/src/components.js"
    },
    "./virtual-modules": {
      "types": "./dist/virtual-modules.d.ts"
    },
    "./lib/hydration-script": {
      "types": "./dist/ts/src/lib/hydration-script.d.ts",
      "import": "./dist/ts/src/lib/hydration-script.js",
      "default": "./dist/ts/src/lib/hydration-script.js"
    },
    "./hydration": {
      "types": "./dist/ts/src/hydration.d.ts",
      "import": "./dist/ts/src/hydration.js",
      "default": "./dist/ts/src/hydration.js"
    }
  },
  "scripts": {
    "test": "nx run astro-cms:test --outputStyle=stream"
  },
  "files": [
    "dist/ts",
    "dist/internal",
    "dist/virtual-modules.d.ts",
    "src",
    "node",
    "!src/__tests__",
    "!**/*.tsbuildinfo"
  ],
  "dependencies": {
    "@conloca/cms-spa": "workspace:*",
    "@conloca/content-api": "workspace:*",
    "@conloca/mdx": "workspace:*",
    "@puckeditor/core": "^0.23.0",
    "@tiptap/core": "^3.31.2",
    "@tiptap/pm": "^3.31.2",
    "acorn": "^8.18.0",
    "clsx": "^2.1.1",
    "fast-glob": "^3.3.3",
    "linkedom": "^0.18.13",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-mdx": "^3.0.0",
    "micromark-extension-mdxjs": "^3.0.0",
    "ts-morph": "^28.0.0",
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "@astrojs/react": "^6.0.5",
    "@vitejs/plugin-react": "^5.2.0",
    "astro": "^7.3.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^7.0.0 || ^8.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/sitemap": "^3.7.3",
    "@happy-dom/global-registrator": "21.0.4",
    "@tiptap/extension-blockquote": "3.31.2",
    "@tiptap/extension-bold": "3.31.2",
    "@tiptap/extension-code": "3.31.2",
    "@tiptap/extension-code-block": "3.31.2",
    "@tiptap/extension-document": "3.31.2",
    "@tiptap/extension-hard-break": "3.31.2",
    "@tiptap/extension-heading": "3.31.2",
    "@tiptap/extension-horizontal-rule": "3.31.2",
    "@tiptap/extension-italic": "3.31.2",
    "@tiptap/extension-link": "3.31.2",
    "@tiptap/extension-list": "3.31.2",
    "@tiptap/extension-paragraph": "3.31.2",
    "@tiptap/extension-strike": "3.31.2",
    "@tiptap/extension-text": "3.31.2",
    "@tiptap/extension-text-align": "3.31.2",
    "@tiptap/extension-underline": "3.31.2",
    "@tiptap/html": "3.31.2",
    "@ttsc/unplugin": "^0.34.1",
    "@vitejs/plugin-react": "^5.2.0",
    "astro": "^7.3.1",
    "fast-check": "^4.9.0",
    "ttsc": "0.34.1",
    "typia": "^14.0.4",
    "vite": "^7.3.6"
  },
  "nx": {
    "targets": {
      "clean": {},
      "bun-web": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "{projectRoot}/src/handlers/page-handler.astro",
          "{projectRoot}/src/internal/acorn-default.mjs",
          "{projectRoot}/src/virtual-modules.d.ts",
          "{projectRoot}/copy-assets.ts"
        ],
        "outputs": [
          "{projectRoot}/dist/internal",
          "{projectRoot}/dist/virtual-modules.d.ts"
        ],
        "options": {
          "command": "bun run copy-assets.ts",
          "cwd": "{projectRoot}"
        }
      },
      "lint": {},
      "typecheck": {
        "dependsOn": [
          "^*-js",
          "typecheck-astro"
        ]
      },
      "typecheck-astro": {
        "executor": "nx:run-commands",
        "cache": true,
        "dependsOn": [
          "build"
        ],
        "inputs": [
          "versionlessProduction",
          "^production",
          "{workspaceRoot}/tsconfig.base.json",
          {
            "json": "{workspaceRoot}/package.json",
            "excludeFields": [
              "version"
            ]
          },
          {
            "json": "{workspaceRoot}/bun.lock",
            "excludeFields": [
              "workspaces"
            ]
          },
          "{projectRoot}/tsconfig.astro.json"
        ],
        "outputs": [],
        "options": {
          "command": "astro check --noSync --tsconfig tsconfig.astro.json --minimumSeverity warning --minimumFailingSeverity warning",
          "cwd": "{projectRoot}"
        }
      },
      "test": {
        "executor": "@smoothbricks/nx-plugin:bounded-exec",
        "dependsOn": [
          "typecheck-tests",
          "build",
          "^build",
          "test-packed"
        ],
        "inputs": [
          "default",
          "^default",
          "{workspaceRoot}/example/website-with-cms/src/**/*"
        ],
        "options": {
          "command": "bun test --timeout=0 --conditions=production --preload=./test-native-preload.ts",
          "cwd": "{projectRoot}",
          "idleTimeoutMs": 180000,
          "killAfterMs": 10000
        }
      },
      "test-packed": {
        "//": "The packed shape is a function of the built outputs, the manifest and the locked dependency closure; cached on exactly those.",
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          {
            "dependentTasksOutputFiles": "**/*",
            "transitive": true
          },
          "{projectRoot}/package.json",
          "{workspaceRoot}/bun.lock",
          "{workspaceRoot}/tooling/packaging/**/*"
        ],
        "dependsOn": [
          "build",
          "^build"
        ],
        "options": {
          "command": "bun tooling/packaging/test-packed.ts astro-cms",
          "cwd": "{workspaceRoot}"
        }
      }
    },
    "tags": [
      "npm:public"
    ],
    "name": "astro-cms"
  },
  "license": "FSL-1.1-ALv2"
}
