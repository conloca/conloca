{
  "name": "@conloca/astro-cms",
  "version": "0.1.15",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conloca/conloca.git",
    "directory": "packages/astro-cms"
  },
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./node": {
      "types": "./dist/node/index.d.mts",
      "import": "./dist/node/index.mjs",
      "default": "./dist/node/index.mjs"
    },
    "./node/content": {
      "types": "./dist/node/content.d.mts",
      "import": "./dist/node/content.mjs",
      "default": "./dist/node/content.mjs"
    },
    "./cms-handler": {
      "types": "./dist/internal/cms-handler.d.mts",
      "import": "./dist/internal/cms-handler.mjs",
      "default": "./dist/internal/cms-handler.mjs"
    },
    "./collections": {
      "types": "./dist/collections.d.mts",
      "import": "./dist/collections.mjs",
      "default": "./dist/collections.mjs"
    },
    "./components": {
      "types": "./dist/components.d.mts",
      "import": "./dist/components.mjs",
      "default": "./dist/components.mjs"
    },
    "./virtual-modules": {
      "types": "./dist/virtual-modules.d.ts"
    },
    "./lib/hydration-script": {
      "types": "./dist/lib/hydration-script.d.mts",
      "import": "./dist/lib/hydration-script.mjs",
      "default": "./dist/lib/hydration-script.mjs"
    },
    "./hydration": {
      "types": "./dist/hydration.d.mts",
      "import": "./dist/hydration.mjs",
      "default": "./dist/hydration.mjs"
    }
  },
  "scripts": {
    "test": "nx run astro-cms:test --outputStyle=stream"
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "dependencies": {
    "@conloca/cms-spa": "workspace:*",
    "@conloca/content-api": "workspace:*",
    "@conloca/mdx": "workspace:*",
    "@puckeditor/core": "^0.21.2",
    "clsx": "^2.1.1",
    "fast-glob": "^3.3.2",
    "ts-morph": "^28.0.0",
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "@vitejs/plugin-react": "^4.0.0",
    "astro": "^6.2.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "vite": "^6.0.0 || ^7.0.0",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "20.6.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@vitejs/plugin-react": "^5.2.0",
    "astro": "^6.2.1",
    "vite": "^7.3.1"
  },
  "nx": {
    "targets": {
      "tsdown-js": {
        "executor": "nx:run-commands",
        "cache": true,
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "{projectRoot}/src/**/*",
          "{projectRoot}/node/**/*",
          "{projectRoot}/tsdown.config.ts",
          "{projectRoot}/tsconfig.lib.json",
          "{projectRoot}/package.json"
        ],
        "outputs": [
          "{projectRoot}/dist/**/*.mjs",
          "{projectRoot}/dist/**/*.d.mts"
        ],
        "options": {
          "command": "tsdown",
          "cwd": "{projectRoot}"
        }
      },
      "bun-web": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "{projectRoot}/src/handlers/page-handler.astro",
          "{projectRoot}/src/internal/acorn-default.mjs",
          "{projectRoot}/src/virtual-modules.d.ts",
          "{projectRoot}/build.ts"
        ],
        "outputs": [
          "{projectRoot}/dist/internal/page-handler.astro",
          "{projectRoot}/dist/internal/acorn-default.mjs",
          "{projectRoot}/dist/virtual-modules.d.ts"
        ],
        "options": {
          "command": "bun run build.ts",
          "cwd": "{projectRoot}"
        }
      },
      "lint": {},
      "test": {
        "executor": "@smoothbricks/nx-plugin:bounded-exec",
        "dependsOn": [
          "typecheck-tests",
          "^build"
        ],
        "options": {
          "command": "bun --conditions=production test",
          "cwd": "{projectRoot}",
          "timeoutMs": 120000,
          "killAfterMs": 10000
        }
      }
    },
    "tags": [
      "npm:public"
    ],
    "name": "astro-cms"
  },
  "license": "FSL-1.1-ALv2"
}
