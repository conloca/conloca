{
  "name": "@conloca/astro-cms",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./components": {
      "development": "./src/components.ts",
      "types": "./dist/components.d.mts",
      "import": "./dist/components.mjs",
      "default": "./dist/components.mjs"
    },
    "./cms-handler": {
      "development": "./src/cms-handler.ts",
      "types": "./dist/cms-handler.d.mts",
      "import": "./dist/cms-handler.mjs",
      "default": "./dist/cms-handler.mjs"
    },
    "./collections": {
      "development": "./src/collections.ts",
      "types": "./dist/collections.d.mts",
      "import": "./dist/collections.mjs",
      "default": "./dist/collections.mjs"
    },
    "./virtual-modules": {
      "types": "./src/virtual-modules.d.ts"
    },
    "./page-handler": {
      "development": "./src/handlers/page-handler.astro",
      "import": "./dist/handlers/page-handler.astro",
      "default": "./dist/handlers/page-handler.astro"
    },
    "./lib/hydration-script": {
      "development": "./src/lib/hydration-script.ts",
      "types": "./dist/lib/hydration-script.d.mts",
      "import": "./dist/lib/hydration-script.mjs",
      "default": "./dist/lib/hydration-script.mjs"
    },
    "./hydration": {
      "development": "./src/hydration.ts",
      "types": "./dist/hydration.d.mts",
      "import": "./dist/hydration.mjs",
      "default": "./dist/hydration.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "tsc-bun-test",
    "test:watch": "bun test --watch"
  },
  "files": [
    "dist",
    "src/handlers",
    "src/virtual-modules.d.ts",
    "!**/*.tsbuildinfo"
  ],
  "dependencies": {
    "@conloca/cms-spa": "workspace:*",
    "@conloca/content-api": "workspace:*",
    "@conloca/content-api-client": "workspace:*",
    "@conloca/mdx": "workspace:*",
    "@measured/puck": "^0.20.2",
    "fast-glob": "^3.3.2",
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "astro": "5.15.3"
  },
  "nx": {
    "targets": {
      "build": {
        "dependsOn": [
          "^build"
        ]
      }
    }
  }
}
