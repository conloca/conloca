{
  "name": "@conloca/astro-cms",
  "version": "0.1.11",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/conloca/private",
    "directory": "packages/astro-cms"
  },
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./components": {
      "types": "./dist/components.d.ts",
      "import": "./dist/components.mjs",
      "default": "./dist/components.mjs"
    },
    "./cms-handler": {
      "types": "./dist/cms-handler.d.ts",
      "import": "./dist/cms-handler.mjs",
      "default": "./dist/cms-handler.mjs"
    },
    "./collections": {
      "types": "./dist/collections.d.ts",
      "import": "./dist/collections.mjs",
      "default": "./dist/collections.mjs"
    },
    "./virtual-modules": {
      "types": "./src/virtual-modules.d.ts"
    },
    "./page-handler": {
      "import": "./dist/handlers/page-handler.astro",
      "default": "./dist/handlers/page-handler.astro"
    },
    "./lib/hydration-script": {
      "types": "./dist/lib/hydration-script.d.ts",
      "import": "./dist/lib/hydration-script.mjs",
      "default": "./dist/lib/hydration-script.mjs"
    },
    "./hydration": {
      "types": "./dist/hydration.d.ts",
      "import": "./dist/hydration.mjs",
      "default": "./dist/hydration.mjs"
    }
  },
  "scripts": {
    "build": "tsdown && mkdir -p dist/handlers && cp src/handlers/page-handler.astro dist/handlers/",
    "test": "tsc-bun-test",
    "test:watch": "bun test --watch"
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "dependencies": {
    "@conloca/cms-spa": "workspace:^",
    "@conloca/content-api": "workspace:^",
    "@conloca/content-api-client": "workspace:^",
    "@conloca/mdx": "workspace:^",
    "@puckeditor/core": "^0.21.1",
    "fast-glob": "^3.3.2",
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "astro": "^5.0.0",
    "vite": "^6.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.6.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@vitejs/plugin-react": "^4.5.2",
    "astro": "5.17.2",
    "vite": "^6.3.5"
  },
  "nx": {
    "targets": {
      "build": {
        "dependsOn": [
          "^build"
        ]
      }
    }
  }
}
