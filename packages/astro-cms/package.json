{
  "name": "@conloca/astro-cms",
  "version": "0.1.14",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conloca/conloca.git",
    "directory": "astro-cms"
  },
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./node": {
      "types": "./dist/node/index.d.mts",
      "import": "./dist/node/index.mjs",
      "default": "./dist/node/index.mjs"
    },
    "./node/content": {
      "types": "./dist/node/content.d.mts",
      "import": "./dist/node/content.mjs",
      "default": "./dist/node/content.mjs"
    },
    "./components": {
      "types": "./dist/components.d.mts",
      "import": "./dist/components.mjs",
      "default": "./dist/components.mjs"
    },
    "./virtual-modules": {
      "types": "./src/virtual-modules.d.ts"
    },
    "./lib/hydration-script": {
      "types": "./dist/lib/hydration-script.d.mts",
      "import": "./dist/lib/hydration-script.mjs",
      "default": "./dist/lib/hydration-script.mjs"
    },
    "./hydration": {
      "types": "./dist/hydration.d.mts",
      "import": "./dist/hydration.mjs",
      "default": "./dist/hydration.mjs"
    }
  },
  "scripts": {
    "build": "tsdown && mkdir -p dist/internal && cp src/handlers/page-handler.astro dist/internal/page-handler.astro && cp src/internal/acorn-default.mjs dist/internal/acorn-default.mjs",
    "test": "tsc-bun-test",
    "test:watch": "bun test --watch"
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "dependencies": {
    "@conloca/cms-spa": "workspace:^",
    "@conloca/content-api": "workspace:^",
    "@conloca/mdx": "workspace:^",
    "@puckeditor/core": "^0.21.1",
    "clsx": "^2.1.1",
    "fast-glob": "^3.3.2",
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "astro": "^5.0.0 || ^6.0.0",
    "vite": "^6.0.0 || ^7.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "20.6.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@vitejs/plugin-react": "^4.5.2",
    "astro": "5.17.2",
    "vite": "^6.3.5"
  },
  "nx": {
    "targets": {
      "build": {
        "dependsOn": [
          "^build"
        ]
      }
    }
  }
}
