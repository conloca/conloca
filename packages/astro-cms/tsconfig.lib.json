{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": false,
    "module": "esnext",
    "moduleResolution": "bundler",
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "types": ["node"],
    "lib": ["ES2020", "DOM", "DOM.Iterable"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": [],
  "references": [
    {
      "path": "../content-api/tsconfig.lib.json"
    },
    {
      "path": "../mdx/tsconfig.lib.json"
    },
    {
      "path": "../content-api-client/tsconfig.lib.json"
    },
    {
      "path": "../cms-spa/tsconfig.lib.json"
    }
  ]
}
