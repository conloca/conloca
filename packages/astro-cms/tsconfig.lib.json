{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist/ts",
    "tsBuildInfoFile": "dist/ts/tsconfig.lib.tsbuildinfo",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "verbatimModuleSyntax": true,
    "sourceMap": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "types": ["node"],
    "lib": ["ES2020", "DOM", "DOM.Iterable"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.d.ts", "node/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "src/__tests__/**/*"],
  "references": [
    { "path": "../mdx/tsconfig.lib.json" },
    { "path": "../content-api/tsconfig.lib.json" },
    { "path": "../cms-spa/tsconfig.lib.json" }
  ]
}
