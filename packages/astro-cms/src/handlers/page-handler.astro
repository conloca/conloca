---
/**
 * Page Handler Component
 *
 * This Astro component is injected via injectRoute() to handle content pages.
 * It implements getStaticPaths() for static page generation and renders
 * content using the Puck Render component with an optional Layout wrapper.
 *
 * MDX blocks are evaluated at build time and rendered as React components.
 */

import { Render, resolveAllData } from '@measured/puck';
import type { ComponentType } from 'react';

// MDX evaluation imports
import { createContentAPI } from '@conloca/content-api/node';
import { evaluateMDXBlocks } from '@conloca/mdx/node';
import { createPageRendererWithBlocks } from '../components/RenderWithBlocks.js';

// Virtual modules configured by the Vite plugin
import routingConfig from 'virtual:conloca-routing-config';
import Layout from 'virtual:conloca-layout';
import { getAllPages, getPage, getDataCollection, contentOptions } from 'virtual:conloca-page-api';
import puckConfig from 'virtual:conloca-puck-config';

// Route utilities for slug extraction
import { extractSlugFromPathname } from '../lib/route-utils.js';

import type { GetStaticPaths } from 'astro';
import type { DataCollectionEntry, DataContext, PageData, ResolvedRoutingConfig } from '../types.js';

// Default to prerender: true for static site generation
export const prerender = true;

/**
 * Generate static paths for all content pages.
 *
 * Iterates through all configured routes and their collections
 * to discover pages and generate the params/props for each.
 */
export const getStaticPaths: GetStaticPaths = async () => {
  // Import config inside getStaticPaths to ensure it's available at build time
  // (Astro hoists getStaticPaths and runs it before module initialization)
  const config = routingConfig as ResolvedRoutingConfig;

  const paths: {
    params: { slug: string | undefined };
    props: { routeName: string; collection: string; pathname: string };
  }[] = [];

  // Skip if routing is disabled
  if (!config.enabled) {
    return paths;
  }

  // For each configured route
  for (const [routeName, routeConfig] of Object.entries(config.routes)) {
    try {
      // Get all pages from this route's collection
      const pages = await getAllPages(routeConfig.collection);

      for (const page of pages) {
        // Convert pathname to slug params
        // Pattern: /blog/[...slug] + pathname: /blog/post-1 = slug: 'post-1'
        const slug = extractSlugFromPathname(page.pathname, routeConfig.pattern);

        paths.push({
          params: { slug },
          props: {
            routeName,
            collection: routeConfig.collection,
            pathname: page.pathname,
          },
        });
      }
    } catch (error) {
      console.error(`[Conloca] Error loading pages for route '${routeName}':`, error);
    }
  }

  return paths;
};

// Props passed from getStaticPaths
interface Props {
  routeName: string;
  collection: string;
  pathname: string;
}

const { routeName, collection, pathname } = Astro.props as Props;

// Cast routing config for component body
const config = routingConfig as ResolvedRoutingConfig;

// Load page data
let page: PageData | undefined;
let loadError: Error | undefined;

try {
  page = await getPage(pathname, collection);

  // Enrich with route information
  if (page && config.routes[routeName]) {
    const routeConfig = config.routes[routeName];
    page.route = {
      name: routeName,
      pattern: routeConfig.pattern,
      meta: routeConfig.meta,
    };
  }
} catch (error) {
  loadError = error as Error;

  // Handle 404 based on fallback configuration
  if ((error as { code?: string }).code === 'PAGE_NOT_FOUND') {
    if (config.fallback === 'passthrough') {
      // Let Astro continue to next route
      return Astro.redirect('/404', 307);
    }
    // Return 404 response
    return new Response('Page not found', { status: 404 });
  }

  // Re-throw other errors
  throw error;
}

// Build metadata with collection data for resolvers
let dataContext: DataContext | undefined;

const routeConfig = config.routes[routeName];
if (routeConfig?.dataBindings?.collections?.length) {
  const collections: Record<string, DataCollectionEntry[]> = {};

  for (const collectionName of routeConfig.dataBindings.collections) {
    try {
      const locale = routeConfig.dataBindings.locale ?? contentOptions.locale;
      collections[collectionName] = await getDataCollection(collectionName, locale);
    } catch (error) {
      console.error(`[Conloca] Failed to fetch collection '${collectionName}':`, error);
      collections[collectionName] = [];
    }
  }

  dataContext = {
    collections,
    locale: routeConfig.dataBindings.locale ?? contentOptions.locale,
    siteName: contentOptions.siteName,
  };
}

// Handle missing puckData gracefully
const hasPuckData = page?.puckData && Object.keys(page.puckData).length > 0;

// Resolve component data if we have bindings
let resolvedPuckData = page?.puckData;

if (hasPuckData && page && dataContext) {
  try {
    resolvedPuckData = await resolveAllData(page.puckData, puckConfig, {
      metadata: dataContext,
    });
  } catch (error) {
    console.error('[Conloca] resolveAllData failed:', error);
    // Fall back to original puckData if resolution fails
  }
}

// Create PageRenderer with MDX blocks support
// This evaluates all MDX blocks at build time and creates a renderer with them baked in
let PageRenderer: ComponentType | undefined;

if (hasPuckData && page && resolvedPuckData) {
  try {
    // Create ContentAPI for MDX evaluation using options from virtual module
    const contentApi = await createContentAPI({
      contentRoot: contentOptions.contentRoot,
      canvasDir: contentOptions.canvasDir,
    });

    // Evaluate MDX blocks - converts MDX content to React components
    const mdxComponents = await evaluateMDXBlocks(contentApi, contentOptions.locale);

    // Create renderer with MDX components baked in via closure
    PageRenderer = createPageRendererWithBlocks(puckConfig, resolvedPuckData, mdxComponents);
  } catch (error) {
    // If MDX evaluation fails, log and fall back to plain Render
    console.error('[Conloca] MDX evaluation failed, falling back to plain render:', error);
    PageRenderer = undefined;
  }
}
---

{Layout && page ? (
  <Layout page={page}>
    {hasPuckData && PageRenderer ? (
      <PageRenderer />
    ) : hasPuckData && resolvedPuckData ? (
      <Render config={puckConfig} data={resolvedPuckData} />
    ) : (
      <div class="conloca-empty-page">
        <p>This page has no content yet.</p>
      </div>
    )}
  </Layout>
) : page ? (
  <html lang="en">
    <head>
      <meta charset="UTF-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1.0" />
      <title>{page.title || 'Untitled'}</title>
      {page.description && <meta name="description" content={page.description} />}
    </head>
    <body>
      {hasPuckData && PageRenderer ? (
        <PageRenderer />
      ) : hasPuckData && resolvedPuckData ? (
        <Render config={puckConfig} data={resolvedPuckData} />
      ) : (
        <div class="conloca-empty-page">
          <p>This page has no content yet.</p>
        </div>
      )}
    </body>
  </html>
) : (
  <html lang="en">
    <head>
      <meta charset="UTF-8" />
      <title>Error</title>
    </head>
    <body>
      <div class="conloca-error">
        <h1>Error Loading Page</h1>
        <p>{loadError?.message || 'An unknown error occurred.'}</p>
      </div>
    </body>
  </html>
)}

<style>
  .conloca-empty-page {
    padding: 2rem;
    text-align: center;
    color: #666;
  }

  .conloca-error {
    padding: 2rem;
    text-align: center;
  }

  .conloca-error h1 {
    color: #c00;
  }
</style>
