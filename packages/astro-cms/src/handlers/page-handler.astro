---
/**
 * Page Handler Component
 *
 * This Astro component is injected via injectRoute() to handle content pages.
 * It implements getStaticPaths() for static page generation and renders
 * content using the Puck Render component with an optional Layout wrapper.
 *
 * MDX fragments are evaluated at build time and rendered as React components.
 */

import { getCollection } from 'astro:content';
import { loadContentSchemas } from 'virtual:conloca-content-schemas';
import Layout from 'virtual:conloca-layout';
import puckConfig from 'virtual:conloca-puck-config';
import routingConfig from 'virtual:conloca-routing-config';
import type { PageData, ResolvedRoutingConfig } from '@conloca/astro-cms';
import { hasHydratableComponents, staticPathParams } from '@conloca/astro-cms';
import { createPageRendererWithFragments, RenderWithHydration } from '@conloca/astro-cms/components';
import { type ContentAPI, isContentPublished, pageTimestampsOf } from '@conloca/content-api';
import { type Data, Render } from '@puckeditor/core';
import type { GetStaticPaths } from 'astro';
import type { ComponentType } from 'react';
// The astro-free render core is emitted by tsc to `dist/ts/src/handlers/`;
// this handler is copied to `dist/internal/`, so it reaches the core with a
// relative path and the extraction adds no public export.
import {
  buildDataContext,
  createCollectionContentSource,
  createReaderContentSource,
  findUnknownComponentTypes,
  getPageEntries,
  loadMdxComponents,
  normalizePathname,
  type PageContentSource,
  type PageEntryData,
  type PageEntryRecord,
  pageNotFoundResponse,
  resolvePuckData,
} from '../ts/src/handlers/page-render-core.js';
import { previewCollectionSchemas } from '../ts/src/internal/collection-schemas.js';

// prerender is controlled by injectRoute({ prerender }) in plugin-spa.ts
// Do not hardcode here — it overrides the route-level config

type AstroCollectionEntry = Awaited<ReturnType<typeof getCollection>>[number];

let evaluateMDXToComponentPromise: Promise<typeof import('@conloca/mdx/node').evaluateMDXToComponent> | undefined;

async function loadEvaluateMDXToComponent() {
  evaluateMDXToComponentPromise ??= import('@conloca/mdx/node').then((module) => module.evaluateMDXToComponent);

  return evaluateMDXToComponentPromise;
}

export const getStaticPaths: GetStaticPaths = async () => {
  const config = routingConfig as ResolvedRoutingConfig;
  const paths: {
    params: Record<string, string | undefined>;
    props: { routeName: string; collection: string; pathname: string };
  }[] = [];

  if (!config.enabled) {
    return paths;
  }

  for (const [routeName, routeConfig] of Object.entries(config.routes)) {
    try {
      const pages = ((await getCollection(routeConfig.collection as never)) as AstroCollectionEntry[])
        .map((entry) => entry.data as Partial<PageEntryData>)
        .filter((data) => {
          if (data.locale !== config.locale || typeof data.pathname !== 'string') {
            return false;
          }

          return isContentPublished(data);
        });

      for (const data of pages) {
        const pathname = data.pathname || '/';

        paths.push({
          params: staticPathParams(pathname, routeConfig.pattern),
          props: {
            routeName,
            collection: routeConfig.collection,
            pathname,
          },
        });
      }
    } catch (error) {
      console.error(`[Conloca] Error loading pages for route '${routeName}':`, error);
    }
  }

  if (import.meta.env.DEV) {
    if (paths.length === 0) {
      console.warn(
        '[Conloca] getStaticPaths returned 0 pages. ' +
          'Check that content collections are populated and pages have locale/pathname fields.',
      );
    } else {
      console.debug(`[Conloca] getStaticPaths: ${paths.length} page(s)`);
    }
  }

  return paths;
};

interface Props {
  routeName: string;
  collection: string;
  pathname: string;
}

const config = routingConfig as ResolvedRoutingConfig;

// In prerender mode, props come from getStaticPaths().
// In SSR mode (prerender: false), derive from the request URL.
const propsFromStaticPaths = Astro.props as Partial<Props>;
let routeName = propsFromStaticPaths.routeName;
let collection = propsFromStaticPaths.collection;
let pathname = propsFromStaticPaths.pathname;

if (!routeName || !collection || !pathname) {
  // SSR fallback: match URL against configured routes. Normalized because
  // browser-facing URLs carry trailing slashes the canonical entry pathnames
  // don't ('/faq/' vs '/faq'), and the page match below is exact equality.
  const requestPath = normalizePathname(Astro.url.pathname);
  for (const [name, routeConfig] of Object.entries(config.routes)) {
    const prefix = routeConfig.pattern.replace(/\[.*$/, '').replace(/\/$/, '');
    if (requestPath === prefix || requestPath.startsWith(`${prefix}/`) || prefix === '') {
      routeName = name;
      collection = routeConfig.collection;
      pathname = requestPath;
      break;
    }
  }

  if (!routeName || !collection || !pathname) {
    // No configured route claims this URL, so there is no collection to look
    // a page up in. Answer exactly as a matched route with no content does.
    // Bound instead of returned directly: TypeScript skips the expression of a
    // `return` outside a function body, so every top-level return in this file
    // names the type it produces to get the call checked.
    const notFound: Response = pageNotFoundResponse(config.fallback);
    return notFound;
  }
}

// Content-access seam. A caller can install a ContentAPI on
// `Astro.locals.contentApi`; when present we read through it, so the page shows
// what that reader serves, parsed with each collection's schema as the build
// parses its entries. Absent — the normal render — we read Astro content
// collections, byte-for-byte identically to before the extraction.
const previewContentApi = (Astro.locals as { contentApi?: ContentAPI }).contentApi;
const source: PageContentSource = previewContentApi
  ? createReaderContentSource(previewContentApi, {
      renderLocale: config.locale,
      schemas: previewCollectionSchemas(config, await loadContentSchemas()),
    })
  : createCollectionContentSource({
      getCollection: (name) => getCollection(name as never) as Promise<{ data: unknown }[]>,
      isDev: import.meta.env.DEV,
    });

let page: PageData | undefined;
let matchedPage: (PageEntryRecord & { pathname: string }) | undefined;
let loadError: Error | undefined;

try {
  const entries = await getPageEntries(source, collection, config.locale);
  matchedPage = entries.find((data) => normalizePathname(data.pathname) === pathname);

  if (!matchedPage) {
    const error = new Error(`Page not found: ${pathname}`) as Error & { code?: string };
    error.code = 'PAGE_NOT_FOUND';
    throw error;
  }

  const data = matchedPage;
  const routeConfig = config.routes[routeName];

  page = {
    id: data.id,
    title: data.title || data.id,
    description: data.description,
    pathname,
    puckData: data.puckData as Data,
    collection,
    route: {
      name: routeName,
      pattern: routeConfig.pattern,
      meta: routeConfig.meta,
    },
    meta: {
      title: data.title,
      description: data.description,
    },
    timestamps: pageTimestampsOf(data),
  };
} catch (error) {
  loadError = error as Error;

  if ((error as { code?: string }).code === 'PAGE_NOT_FOUND') {
    const notFound: Response = pageNotFoundResponse(config.fallback);
    return notFound;
  }

  throw error;
}

const dataContext = await buildDataContext(source, config.routes[routeName], config, matchedPage);

const hasPuckData = !!page?.puckData && Object.keys(page.puckData).length > 0;
let resolvedPuckData = page?.puckData;

if (hasPuckData && page) {
  resolvedPuckData = await resolvePuckData(page.puckData, puckConfig, dataContext);
}

if (hasPuckData && resolvedPuckData) {
  const unknown = findUnknownComponentTypes(resolvedPuckData, puckConfig);
  if (unknown.length > 0) {
    console.error(
      `[Conloca] Page references ${unknown.length} component type(s) missing from your Puck config: ` +
        `${unknown.join(', ')}. Puck renders unknown components as nothing, so these will be blank. ` +
        'Register them in the file named by puckConfigPath.',
    );
  }
}

const needsHydration = hasPuckData && resolvedPuckData && hasHydratableComponents(resolvedPuckData, puckConfig);

let PageRenderer: ComponentType | undefined;

if (hasPuckData && page && resolvedPuckData) {
  try {
    const mdxComponents = await loadMdxComponents(
      source,
      config.locale,
      await loadEvaluateMDXToComponent(),
      import.meta.env.DEV,
    );
    PageRenderer = createPageRendererWithFragments(puckConfig, resolvedPuckData, mdxComponents, dataContext);
  } catch (error) {
    console.error('[Conloca] MDX evaluation failed, falling back to plain render:', error);
    PageRenderer = undefined;
  }
}
---

{Layout && page ? (
  <Layout title={page.title ?? 'Page'} description={page.description} page={dataContext.page}>
    {hasPuckData && PageRenderer ? (
      <PageRenderer />
    ) : hasPuckData && resolvedPuckData ? (
      needsHydration ? (
        <RenderWithHydration config={puckConfig} data={resolvedPuckData} metadata={dataContext} />
      ) : (
        <Render config={puckConfig} data={resolvedPuckData} metadata={dataContext} />
      )
    ) : (
      <div class="conloca-empty-page">
        <p>This page has no content yet.</p>
      </div>
    )}
  </Layout>
) : page ? (
  <html lang={config.locale || 'en'}>
    <head>
      <meta charset="UTF-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1.0" />
      <title>{page.title || 'Untitled'}</title>
      {page.description && <meta name="description" content={page.description} />}
      {needsHydration && <script>import 'virtual:conloca-hydration-entry'</script>}
    </head>
    <body>
      {hasPuckData && PageRenderer ? (
        <PageRenderer />
      ) : hasPuckData && resolvedPuckData ? (
        needsHydration ? (
          <RenderWithHydration config={puckConfig} data={resolvedPuckData} metadata={dataContext} />
        ) : (
          <Render config={puckConfig} data={resolvedPuckData} metadata={dataContext} />
        )
      ) : (
        <div class="conloca-empty-page">
          <p>This page has no content yet.</p>
        </div>
      )}
    </body>
  </html>
) : (
  <html lang="en">
    <head>
      <meta charset="UTF-8" />
      <title>Error</title>
    </head>
    <body>
      <div class="conloca-error">
        <h1>Error Loading Page</h1>
        <p>{import.meta.env.DEV ? (loadError?.message || 'An unknown error occurred.') : 'An error occurred while loading this page.'}</p>
      </div>
    </body>
  </html>
)}

{Layout && needsHydration && <script>import 'virtual:conloca-hydration-entry'</script>}

<style>
  .conloca-empty-page {
    padding: 2rem;
    text-align: center;
    color: #666;
  }

  .conloca-error {
    padding: 2rem;
    text-align: center;
  }

  .conloca-error h1 {
    color: #c00;
  }
</style>
