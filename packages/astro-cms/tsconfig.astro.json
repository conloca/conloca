{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "noUnusedLocals": false,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "noEmit": true
  },
  "include": ["src/env.d.ts", "dist/virtual-modules.d.ts", "dist/internal/page-handler.astro"]
}
