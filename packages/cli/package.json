{
  "name": "@conloca/cli",
  "version": "0.2.3-next.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conloca/conloca.git",
    "directory": "packages/cli"
  },
  "dependencies": {
    "@conloca/astro-cms": "workspace:*",
    "@conloca/content-api": "workspace:*",
    "diff": "^9.0.0",
    "magicast": "^0.5.5"
  },
  "peerDependencies": {
    "@conloca/cloud-astro": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@conloca/cloud-astro": {
      "optional": true
    }
  },
  "bin": {
    "conloca": "./dist/conloca.js"
  },
  "scripts": {
    "build": "nx run cli:build",
    "test": "nx run cli:test --outputStyle=stream"
  },
  "type": "module",
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "devDependencies": {
    "@conloca/cloud-astro": "workspace:*",
    "@types/bun": "1.4.2",
    "commander": "^15.0.0"
  },
  "nx": {
    "targets": {
      "clean": {},
      "lint": {},
      "typecheck": {
        "//": "No tsconfig.lib.json -- the published bundle is built by the `build` target, not by tsc -- so inference derives no typecheck. tsconfig.json is the library program here (19 files).",
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "default",
          "^production"
        ],
        "dependsOn": [
          "^*-js"
        ],
        "options": {
          "command": "tsc -p tsconfig.json --noEmit",
          "cwd": "{projectRoot}"
        }
      },
      "build": {
        "//": "The bundle inlines src/templates/conloca-skill.md. The default input excludes every Markdown file, and that exclusion wins over a file listed by name, so the project's own files are hashed in full.",
        "executor": "nx:run-commands",
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "{projectRoot}/**/*",
          "^default"
        ],
        "options": {
          "command": "bun run build.ts",
          "cwd": "{projectRoot}"
        }
      },
      "typecheck-tests": {
        "//": "The test program also compiles the shared git-isolation harness it imports from tooling/.",
        "inputs": [
          "...",
          "{workspaceRoot}/tooling/git-env-isolation.ts",
          "{workspaceRoot}/tooling/git-local-env.ts"
        ]
      },
      "test": {
        "//": "test/skill.test.ts reads src/templates/conloca-skill.md, which the default input would exclude even when listed by name, so the project's own files are hashed in full.",
        "executor": "@smoothbricks/nx-plugin:bounded-exec",
        "dependsOn": [
          "build",
          "typecheck-tests",
          "test-packed"
        ],
        "inputs": [
          "{projectRoot}/**/*",
          "^default",
          "{workspaceRoot}/example/website-with-cms/package.json",
          "{workspaceRoot}/tooling/test-setup.ts",
          "{workspaceRoot}/tooling/git-local-env.ts",
          "{workspaceRoot}/tooling/git-env-isolation.ts"
        ],
        "options": {
          "command": "bun test --timeout=0",
          "cwd": "{projectRoot}",
          "idleTimeoutMs": 180000,
          "killAfterMs": 10000
        }
      },
      "test-packed": {
        "//": "The packed shape is a function of the built outputs, the manifest and the locked dependency closure; cached on exactly those.",
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          {
            "dependentTasksOutputFiles": "**/*",
            "transitive": true
          },
          "{projectRoot}/package.json",
          "{workspaceRoot}/bun.lock",
          "{workspaceRoot}/tooling/packaging/**/*"
        ],
        "dependsOn": [
          "build",
          "^build"
        ],
        "options": {
          "command": "bun tooling/packaging/test-packed.ts cli",
          "cwd": "{workspaceRoot}"
        }
      }
    },
    "tags": [
      "npm:public"
    ],
    "name": "cli"
  },
  "license": "FSL-1.1-ALv2"
}
