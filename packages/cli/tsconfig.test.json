{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "noEmit": true,
    "types": ["bun"]
  },
  "include": [
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/__tests__/**/*.ts",
    "src/**/__tests__/**/*.tsx",
    "test/**/*.ts",
    "test/**/*.tsx",
    "src/test-suite-tracer.ts"
  ],
  "references": [
    {
      "path": "../astro-cms/tsconfig.lib.json"
    },
    {
      "path": "../content-api/tsconfig.lib.json"
    }
  ]
}
