{
  "name": "@conloca/cms-spa",
  "version": "0.1.15",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conloca/conloca.git",
    "directory": "packages/cms-spa"
  },
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./data-schemas": {
      "types": "./dist/data-schemas.d.mts",
      "import": "./dist/data-schemas.mjs",
      "default": "./dist/data-schemas.mjs"
    },
    "./mdx-components": {
      "types": "./dist/mdx-components.d.mts",
      "import": "./dist/mdx-components.mjs",
      "default": "./dist/mdx-components.mjs"
    },
    "./page-schemas": {
      "types": "./dist/page-schemas.d.mts",
      "import": "./dist/page-schemas.mjs",
      "default": "./dist/page-schemas.mjs"
    },
    "./puck-config": {
      "types": "./dist/puck-config.d.mts",
      "import": "./dist/puck-config.mjs",
      "default": "./dist/puck-config.mjs"
    },
    "./site-styles": {
      "types": "./dist/site-styles.d.mts",
      "import": "./dist/site-styles.mjs",
      "default": "./dist/site-styles.mjs"
    },
    "./mock-puck-config": {
      "types": "./dist/mock-puck-config.d.ts",
      "import": "./dist/mock-puck-config.mjs",
      "default": "./dist/mock-puck-config.mjs"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "import": "./dist/ui.mjs",
      "default": "./dist/ui.mjs"
    },
    "./dialog": {
      "types": "./dist/dialog.d.ts",
      "import": "./dist/dialog.mjs",
      "default": "./dist/dialog.mjs"
    },
    "./main": {
      "import": "./dist/main.mjs",
      "default": "./dist/main.mjs"
    },
    "./tailwind-theme.css": "./styles/tailwind-theme.css",
    "./styles.css": "./dist/spa/main.css",
    "./dist/spa/*": "./dist/spa/*"
  },
  "files": [
    "dist",
    "styles",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build:dev": "NODE_ENV=development bun build-spa.ts",
    "dev": "nx run cms-spa:dev --outputStyle=stream",
    "test": "nx run cms-spa:test --outputStyle=stream"
  },
  "dependencies": {
    "@conloca/content-api-client": "workspace:*",
    "@conloca/mdx": "workspace:*",
    "@lexical/react": "^0.35.0",
    "@mdxeditor/editor": "^3.55.0",
    "@puckeditor/core": "^0.21.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-select": "^2.2.6",
    "@tanstack/react-query": "^5.100.6",
    "@tanstack/react-query-devtools": "^5.100.6",
    "clsx": "^2.1.1",
    "lucide-react": "^0.564.0",
    "mdast-util-from-markdown": "^2.0.0",
    "mdast-util-mdx-jsx": "^3.0.0",
    "react-router-dom": "^7.14.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tslib": "^2.8.1",
    "zod": "^4.4.1"
  },
  "peerDependencies": {
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "20.6.1",
    "@tailwindcss/cli": "4.2.4",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "bun-tailwindcss": "^0.0.9",
    "hono": "^4.12.16",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-refresh-typescript": "^2.0.12",
    "tailwindcss": "^4.1.16",
    "typescript": "^6.0.3"
  },
  "nx": {
    "targets": {
      "dev": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "^build"
        ],
        "continuous": true,
        "options": {
          "command": "bun --bun --hot dev-server.tsx",
          "cwd": "{projectRoot}"
        }
      },
      "lint": {},
      "tsdown-js": {
        "executor": "nx:run-commands",
        "cache": true,
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "{projectRoot}/src/**/*",
          "{projectRoot}/tsdown.config.ts",
          "{projectRoot}/tsconfig.lib.json",
          "{projectRoot}/package.json"
        ],
        "outputs": [
          "{projectRoot}/dist/**/*.mjs",
          "{projectRoot}/dist/**/*.js",
          "{projectRoot}/dist/**/*.d.mts"
        ],
        "options": {
          "command": "tsdown",
          "cwd": "{projectRoot}"
        }
      },
      "bun-web": {
        "executor": "nx:run-commands",
        "cache": true,
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "{projectRoot}/src/**/*",
          "{projectRoot}/build-spa.ts",
          "{projectRoot}/tailwind-config.ts",
          "{projectRoot}/package.json"
        ],
        "outputs": [
          "{projectRoot}/dist/spa/**"
        ],
        "options": {
          "command": "bun build-spa.ts",
          "cwd": "{projectRoot}"
        }
      },
      "test": {
        "executor": "@smoothbricks/nx-plugin:bounded-exec",
        "dependsOn": [
          "typecheck-tests",
          "^build"
        ],
        "options": {
          "command": "bun test",
          "cwd": "{projectRoot}",
          "timeoutMs": 120000,
          "killAfterMs": 10000
        }
      }
    },
    "tags": [
      "npm:public"
    ],
    "name": "cms-spa"
  },
  "license": "FSL-1.1-ALv2"
}
