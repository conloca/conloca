{
  "name": "@conloca/cms-spa",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./dist/spa/*": "./dist/spa/*"
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "bun build-spa.ts",
    "build:dev": "NODE_ENV=development bun build-spa.ts",
    "dev": "bun --bun --hot dev-server.tsx",
    "test": "tsc-bun-test",
    "test:watch": "bun test --watch"
  },
  "dependencies": {
    "@conloca/content-api-client": "workspace:*",
    "@conloca/mdx-editor": "workspace:*",
    "@measured/puck": "^0.19.1",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-select": "^2.2.5",
    "@tanstack/react-query": "^5.81.5",
    "@tanstack/react-query-devtools": "^5.81.5",
    "clsx": "^2.1.1",
    "lucide-react": "^0.525.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-router-dom": "^7.7.1",
    "tailwind-merge": "^3.3.1",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^18.0.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "bun-tailwindcss": "^0.0.8",
    "react-refresh-typescript": "^2.0.10",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.9.2"
  },
  "nx": {
    "targets": {
      "build": {
        "dependsOn": [
          "^build"
        ]
      },
      "build:dev": {
        "dependsOn": [
          "^build"
        ]
      },
      "dev": {
        "dependsOn": [
          "^build"
        ],
        "continuous": true
      }
    }
  }
}
