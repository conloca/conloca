{
  "name": "@conloca/cms-spa",
  "version": "0.2.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conloca/conloca.git",
    "directory": "packages/cms-spa"
  },
  "type": "module",
  "main": "./dist/ts/index.js",
  "module": "./dist/ts/index.js",
  "types": "./dist/ts/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/ts/index.d.ts",
      "import": "./dist/ts/index.js",
      "default": "./dist/ts/index.js"
    },
    "./data-schemas": {
      "types": "./dist/ts/data-schemas.d.ts",
      "import": "./dist/ts/data-schemas.js",
      "default": "./dist/ts/data-schemas.js"
    },
    "./mdx-components": {
      "types": "./dist/ts/mdx-components.d.ts",
      "import": "./dist/ts/mdx-components.js",
      "default": "./dist/ts/mdx-components.js"
    },
    "./mdx-components-define": {
      "types": "./dist/ts/mdx-components-define.d.ts",
      "import": "./dist/ts/mdx-components-define.js",
      "default": "./dist/ts/mdx-components-define.js"
    },
    "./page-schemas": {
      "types": "./dist/ts/page-schemas.d.ts",
      "import": "./dist/ts/page-schemas.js",
      "default": "./dist/ts/page-schemas.js"
    },
    "./page-schema-define": {
      "types": "./dist/ts/page-schema-define.d.ts",
      "import": "./dist/ts/page-schema-define.js",
      "default": "./dist/ts/page-schema-define.js"
    },
    "./page-setting-attributes": {
      "types": "./dist/ts/page-setting-attributes.d.ts",
      "import": "./dist/ts/page-setting-attributes.js",
      "default": "./dist/ts/page-setting-attributes.js"
    },
    "./merge-default-props": {
      "types": "./dist/ts/merge-default-props.d.ts",
      "import": "./dist/ts/merge-default-props.js",
      "default": "./dist/ts/merge-default-props.js"
    },
    "./content-wrapper": {
      "types": "./dist/ts/content-wrapper.d.ts",
      "import": "./dist/ts/content-wrapper.js",
      "default": "./dist/ts/content-wrapper.js"
    },
    "./puck-config": {
      "types": "./dist/ts/puck-config.d.ts",
      "import": "./dist/ts/puck-config.js",
      "default": "./dist/ts/puck-config.js"
    },
    "./site-styles": {
      "types": "./dist/ts/site-styles.d.ts",
      "import": "./dist/ts/site-styles.js",
      "default": "./dist/ts/site-styles.js"
    },
    "./theme": {
      "types": "./dist/ts/theme.d.ts",
      "import": "./dist/ts/theme.js",
      "default": "./dist/ts/theme.js"
    },
    "./frame-protocol": {
      "types": "./dist/ts/frame/protocol.d.ts",
      "import": "./dist/ts/frame/protocol.js",
      "default": "./dist/ts/frame/protocol.js"
    },
    "./frame-channel": {
      "types": "./dist/ts/frame/channel.d.ts",
      "import": "./dist/ts/frame/channel.js",
      "default": "./dist/ts/frame/channel.js"
    },
    "./mock-puck-config": {
      "types": "./dist/ts/mock-puck-config.d.ts",
      "import": "./dist/ts/mock-puck-config.js",
      "default": "./dist/ts/mock-puck-config.js"
    },
    "./ui": {
      "types": "./dist/ts/components/ui/index.d.ts",
      "import": "./dist/ts/components/ui/index.js",
      "default": "./dist/ts/components/ui/index.js"
    },
    "./dialog": {
      "types": "./dist/ts/components/dialog.d.ts",
      "import": "./dist/ts/components/dialog.js",
      "default": "./dist/ts/components/dialog.js"
    },
    "./toast": {
      "types": "./dist/ts/components/toast.d.ts",
      "import": "./dist/ts/components/toast.js",
      "default": "./dist/ts/components/toast.js"
    },
    "./main": {
      "types": "./dist/ts/main.d.ts",
      "import": "./dist/ts/main.js",
      "default": "./dist/ts/main.js"
    },
    "./tailwind-theme.css": {
      "types": "./styles/stylesheet.d.ts",
      "default": "./styles/tailwind-theme.css"
    },
    "./styles.css": {
      "types": "./styles/stylesheet.d.ts",
      "default": "./dist/spa/main.css"
    },
    "./dist/spa/*": "./dist/spa/*"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.*",
    "!src/**/*.stories.*",
    "styles",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build:dev": "NODE_ENV=development bun build-spa.ts",
    "dev": "nx run cms-spa:dev --outputStyle=stream",
    "test": "nx run cms-spa:test --outputStyle=stream"
  },
  "dependencies": {
    "@conloca/content-api-client": "workspace:*",
    "@conloca/mdx": "workspace:*",
    "@lexical/react": "^0.48.0",
    "@mdxeditor/editor": "^4.2.3",
    "@puckeditor/core": "^0.23.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-select": "^2.3.7",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@types/mdast": "^4.0.4",
    "@typia/interface": "^14.0.5",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.17",
    "lexical": "^0.48.0",
    "lucide-react": "^0.564.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-mdx-jsx": "^3.2.0",
    "react-router-dom": "^7.18.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "21.0.4",
    "@storybook/addon-vitest": "^10.6.2",
    "@storybook/react-vite": "^10.6.2",
    "@tailwindcss/cli": "4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@ttsc/unplugin": "^0.34.1",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/browser-playwright": "^4.1.11",
    "bun-tailwindcss": "^0.0.9",
    "fast-check": "^4.9.0",
    "hono": "^4.13.5",
    "playwright": "^1.62.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-refresh-typescript": "^2.0.12",
    "storybook": "^10.6.2",
    "tailwindcss": "^4.3.3",
    "ttsc": "0.34.1",
    "typescript": "^6.0.3",
    "typia": "^14.0.4",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "nx": {
    "targets": {
      "clean": {},
      "dev": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "^build"
        ],
        "continuous": true,
        "options": {
          "command": "bun --bun --hot dev-server.tsx",
          "cwd": "{projectRoot}"
        }
      },
      "lint": {},
      "bun-web": {
        "executor": "nx:run-commands",
        "cache": true,
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "{projectRoot}/src/**/*",
          "{projectRoot}/build-spa.ts",
          "{projectRoot}/tailwind-config.ts",
          "{projectRoot}/package.json"
        ],
        "outputs": [
          "{projectRoot}/dist/spa/**"
        ],
        "options": {
          "command": "bun build-spa.ts",
          "cwd": "{projectRoot}"
        }
      },
      "test": {
        "executor": "@smoothbricks/nx-plugin:bounded-exec",
        "dependsOn": [
          "typecheck-tests",
          "bun-web",
          "^build",
          "test-packed"
        ],
        "options": {
          "command": "bun test --timeout=0 --conditions=production",
          "cwd": "{projectRoot}",
          "idleTimeoutMs": 180000,
          "killAfterMs": 10000
        }
      },
      "build-storybook": {
        "executor": "@smoothbricks/nx-plugin:bounded-exec",
        "cache": true,
        "dependsOn": [
          "^build",
          "bun-web"
        ],
        "inputs": [
          "default",
          "^production",
          "{workspaceRoot}/package.json",
          "{workspaceRoot}/bun.lock"
        ],
        "outputs": [
          "{workspaceRoot}/dist/storybook/cms-spa"
        ],
        "options": {
          "command": "bunx --no-install storybook build --config-dir .storybook --output-dir ../../dist/storybook/cms-spa --disable-telemetry",
          "cwd": "{projectRoot}",
          "timeoutMs": 300000,
          "killAfterMs": 1e4
        }
      },
      "test-browser": {
        "executor": "@smoothbricks/nx-plugin:bounded-exec",
        "cache": true,
        "parallelism": false,
        "inputs": [
          "default",
          "^production"
        ],
        "dependsOn": [
          "^build",
          "build-storybook"
        ],
        "options": {
          "command": "smoo playwright ensure chromium && vitest run --config .storybook/vitest.config.ts",
          "cwd": "{projectRoot}",
          "timeoutMs": 300000,
          "killAfterMs": 10000
        }
      },
      "test-packed": {
        "//": "The packed shape is a function of the built outputs, the stylesheets and their declarations shipped as written, the manifest and the locked dependency closure; cached on exactly those.",
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          {
            "dependentTasksOutputFiles": "**/*",
            "transitive": true
          },
          "{projectRoot}/styles/**/*",
          "{projectRoot}/package.json",
          "{workspaceRoot}/bun.lock",
          "{workspaceRoot}/tooling/packaging/**/*"
        ],
        "dependsOn": [
          "build",
          "^build"
        ],
        "options": {
          "command": "bun tooling/packaging/test-packed.ts cms-spa",
          "cwd": "{workspaceRoot}"
        }
      }
    },
    "tags": [
      "npm:public"
    ],
    "name": "cms-spa"
  },
  "license": "FSL-1.1-ALv2"
}
