{
  "name": "@conloca/cms-spa",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./data-schemas": {
      "types": "./dist/data-schemas.d.ts",
      "import": "./dist/data-schemas.js",
      "default": "./dist/data-schemas.js"
    },
    "./puck-config": {
      "types": "./dist/puck-config.d.ts",
      "import": "./dist/puck-config.js",
      "default": "./dist/puck-config.js"
    },
    "./dist/spa/*": "./dist/spa/*"
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "bun build-spa.ts",
    "build:dev": "NODE_ENV=development bun build-spa.ts",
    "dev": "bun --bun --hot dev-server.tsx",
    "test": "tsc-bun-test",
    "test:watch": "bun test --watch"
  },
  "dependencies": {
    "@conloca/content-api-client": "workspace:*",
    "@conloca/mdx": "workspace:*",
    "@measured/puck": "^0.20.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-select": "^2.2.6",
    "@tanstack/react-query": "^5.90.5",
    "@tanstack/react-query-devtools": "^5.90.2",
    "clsx": "^2.1.1",
    "lucide-react": "^0.552.0",
    "react-router-dom": "^7.9.5",
    "tailwind-merge": "^3.3.1",
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.0.10",
    "@tailwindcss/cli": "4.1.16",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "bun-tailwindcss": "^0.0.9",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-refresh-typescript": "^2.0.11",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.9.3"
  },
  "nx": {
    "targets": {
      "build": {
        "dependsOn": [
          "^build"
        ]
      },
      "build:dev": {
        "dependsOn": [
          "^build"
        ]
      },
      "dev": {
        "dependsOn": [
          "^build"
        ],
        "continuous": true
      }
    }
  }
}
