{
  "//": "Type-check only. The typia transform ttsc would pick up from this package's dependencies is disabled: its native emit fails on the .tsx tests, and the Typia fixtures type-check as declared. test-native-preload.ts runs the transform where tests execute.",
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "noEmit": true,
    "types": ["bun", "vite/client"],
    "plugins": [{ "transform": "typia/lib/transform", "enabled": false }]
  },
  "include": [
    "test-types.d.ts",
    "test-setup.ts",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.stories.tsx",
    "src/**/__tests__/**/*.ts",
    "src/**/__tests__/**/*.tsx",
    "src/test-suite-tracer.ts",
    "test/**/*.ts",
    "test/**/*.tsx",
    "src/**/*.spec.tsx"
  ],
  "references": [
    {
      "path": "./tsconfig.lib.json"
    },
    {
      "path": "../content-api-client/tsconfig.lib.json"
    },
    {
      "path": "../mdx/tsconfig.lib.json"
    }
  ]
}
