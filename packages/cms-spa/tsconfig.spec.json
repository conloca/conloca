{
  "extends": "./tsconfig.lib.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "types": ["node", "bun"],
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "rootDir": "."
