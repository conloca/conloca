{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.exports.tsbuildinfo",
    "emitDeclarationOnly": false,
    "declaration": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2020",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "composite": true
  },
  "files": [
    "src/index.ts",
    "src/types.ts",
    "src/mock-puck-config.tsx",
    "src/ui-config.ts",
    "src/components/puck/index.ts",
    "src/components/puck/MDXContent.tsx"
  ]
}
