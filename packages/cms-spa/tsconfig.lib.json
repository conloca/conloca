{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist/ts",
    "tsBuildInfoFile": "dist/ts/tsconfig.lib.tsbuildinfo",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "verbatimModuleSyntax": true,
    "sourceMap": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "types": ["node"],
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "plugins": [{ "transform": "typia/lib/transform" }]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/**/*.stories.tsx"],
  "references": [
    { "path": "../content-api/tsconfig.lib.json" },
    { "path": "../mdx/tsconfig.lib.json" },
    { "path": "../content-api-client/tsconfig.lib.json" }
  ]
}
