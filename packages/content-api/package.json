{
  "name": "@conloca/content-api",
  "version": "0.2.7-next.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conloca/conloca.git",
    "directory": "packages/content-api"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "fast-glob": "^3.3.3",
    "gray-matter": "^4.0.3",
    "hono": "^4.13.5",
    "image-size": "^2.0.2",
    "jose": "^6.2.10",
    "nanoid": "^6.0.1",
    "sort-keys": "^6.0.1",
    "svgo": "^4.1.0",
    "tslib": "^2.8.1",
    "typia": "^14.0.6",
    "xxhash-wasm": "^1.1.0",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "vite": "^7.0.0 || ^8.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@ttsc/unplugin": "0.34.1",
    "fast-check": "^4.9.0",
    "ttsc": "0.34.1",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "default": "./dist/node.js"
    },
    "./indexing": {
      "types": "./dist/indexing.d.ts",
      "import": "./dist/indexing.js",
      "default": "./dist/indexing.js"
    },
    "./content-path": {
      "types": "./dist/content-path.d.ts",
      "import": "./dist/content-path.js",
      "default": "./dist/content-path.js"
    },
    "./upload-bytes": {
      "types": "./dist/upload-bytes.d.ts",
      "import": "./dist/upload-bytes.js",
      "default": "./dist/upload-bytes.js"
    },
    "./draft-media-ref": {
      "types": "./dist/draft-media-ref.d.ts",
      "import": "./dist/draft-media-ref.js",
      "default": "./dist/draft-media-ref.js"
    },
    "./asset-naming": {
      "types": "./dist/asset-naming.d.ts",
      "import": "./dist/asset-naming.js",
      "default": "./dist/asset-naming.js"
    },
    "./lfs-attributes": {
      "types": "./dist/lfs-attributes.d.ts",
      "import": "./dist/lfs-attributes.js",
      "default": "./dist/lfs-attributes.js"
    },
    "./asset-metadata-record": {
      "types": "./dist/asset-metadata-record.d.ts",
      "import": "./dist/asset-metadata-record.js",
      "default": "./dist/asset-metadata-record.js"
    },
    "./content-file-id": {
      "types": "./dist/content-file-id.d.ts",
      "import": "./dist/content-file-id.js",
      "default": "./dist/content-file-id.js"
    },
    "./vxjson-serialize": {
      "types": "./dist/vxjson-serialize.d.ts",
      "import": "./dist/vxjson-serialize.js",
      "default": "./dist/vxjson-serialize.js"
    },
    "./reader": {
      "types": "./dist/reader.d.ts",
      "import": "./dist/reader.js",
      "default": "./dist/reader.js"
    },
    "./schemas": {
      "types": "./dist/schemas/index.d.ts",
      "import": "./dist/schemas/index.js",
      "default": "./dist/schemas/index.js"
    },
    "./component-vocabulary": {
      "types": "./dist/component-vocabulary.d.ts",
      "import": "./dist/component-vocabulary.js",
      "default": "./dist/component-vocabulary.js"
    },
    "./editor-host": {
      "types": "./dist/editor-host.d.ts",
      "import": "./dist/editor-host.js",
      "default": "./dist/editor-host.js"
    },
    "./skill-stamp": {
      "types": "./dist/skill-stamp.d.ts",
      "import": "./dist/skill-stamp.js",
      "default": "./dist/skill-stamp.js"
    }
  },
  "scripts": {
    "test": "nx run content-api:test --outputStyle=stream"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "!**/*.tsbuildinfo"
  ],
  "nx": {
    "targets": {
      "lint": {},
      "typecheck-tests": {
        "//": "The test program also compiles the shared git-isolation harness it imports from tooling/.",
        "inputs": [
          "...",
          "{workspaceRoot}/tooling/git-env-isolation.ts",
          "{workspaceRoot}/tooling/git-local-env.ts"
        ]
      },
      "test": {
        "executor": "@smoothbricks/nx-plugin:bounded-exec",
        "dependsOn": [
          "typecheck-tests",
          "test-packed"
        ],
        "inputs": [
          "default",
          "^default",
          "{workspaceRoot}/tooling/test-setup.ts",
          "{workspaceRoot}/tooling/git-local-env.ts",
          "{workspaceRoot}/tooling/git-env-isolation.ts"
        ],
        "options": {
          "command": "bun test --preload ./test-native-preload.ts --timeout=0",
          "cwd": "{projectRoot}",
          "idleTimeoutMs": 180000,
          "killAfterMs": 10000
        }
      },
      "mutation": {
        "executor": "nx:run-commands",
        "cache": true,
        "options": {
          "command": "stryker run stryker.pilot.config.mjs",
          "cwd": "{projectRoot}"
        },
        "inputs": [
          "default",
          "^default"
        ],
        "outputs": []
      },
      "test-packed": {
        "//": "The packed shape is a function of the built outputs, the manifest and the locked dependency closure; cached on exactly those.",
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          {
            "dependentTasksOutputFiles": "**/*",
            "transitive": true
          },
          "{projectRoot}/package.json",
          "{workspaceRoot}/bun.lock",
          "{workspaceRoot}/tooling/packaging/**/*"
        ],
        "dependsOn": [
          "build",
          "^build"
        ],
        "options": {
          "command": "bun tooling/packaging/test-packed.ts content-api",
          "cwd": "{workspaceRoot}"
        }
      }
    },
    "tags": [
      "npm:public"
    ],
    "name": "content-api"
  },
  "license": "FSL-1.1-ALv2"
}
