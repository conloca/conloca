{
  "name": "@conloca/content-api",
  "version": "0.1.15",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conloca/conloca.git",
    "directory": "packages/content-api"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "dependencies": {
    "@hono/node-server": "^1.19.14",
    "@node-rs/xxhash": "^1.7.6",
    "fast-glob": "^3.3.2",
    "gray-matter": "^4.0.3",
    "hono": "^4.12.16",
    "image-size": "^2.0.2",
    "jose": "^6.2.3",
    "nanoid": "^5.1.10",
    "sort-keys": "^6.0.0",
    "tslib": "^2.8.1",
    "yaml": "^2.8.3",
    "zod": "^4.4.1"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./node": {
      "types": "./dist/node.d.mts",
      "import": "./dist/node.mjs",
      "default": "./dist/node.mjs"
    },
    "./reader": {
      "types": "./dist/reader.d.mts",
      "import": "./dist/reader.mjs",
      "default": "./dist/reader.mjs"
    },
    "./schemas": {
      "types": "./dist/schemas/index.d.mts",
      "import": "./dist/schemas/index.mjs",
      "default": "./dist/schemas/index.mjs"
    }
  },
  "scripts": {
    "test": "nx run content-api:test --outputStyle=stream"
  },
  "type": "module",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "nx": {
    "targets": {
      "lint": {},
      "tsdown-js": {
        "executor": "nx:run-commands",
        "cache": true,
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "{projectRoot}/src/**/*",
          "{projectRoot}/tsdown.config.ts",
          "{projectRoot}/tsconfig.lib.json",
          "{projectRoot}/package.json"
        ],
        "outputs": [
          "{projectRoot}/dist/**/*.mjs",
          "{projectRoot}/dist/**/*.js"
        ],
        "options": {
          "command": "tsdown",
          "cwd": "{projectRoot}"
        }
      },
      "test": {
        "executor": "@smoothbricks/nx-plugin:bounded-exec",
        "dependsOn": [
          "typecheck-tests"
        ],
        "options": {
          "command": "bun test",
          "cwd": "{projectRoot}",
          "timeoutMs": 120000,
          "killAfterMs": 10000
        }
      }
    },
    "tags": [
      "npm:public"
    ],
    "name": "content-api"
  },
  "license": "FSL-1.1-ALv2"
}
