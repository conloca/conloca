  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/conloca/private",
    "directory": "packages/content-api"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "dependencies": {
    "@hono/node-server": "^1.19.5",
    "@node-rs/xxhash": "^1.7.6",
    "fast-glob": "^3.3.2",
    "gray-matter": "^4.0.3",
    "hono": "^4.10.4",
    "image-size": "^2.0.2",
    "jose": "^6.0.10",
