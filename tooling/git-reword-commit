#!/usr/bin/env bash
#
# git-reword-commit - Rewrite a commit message without affecting worktree
#
# Usage:
#   echo "new message" | git-reword-commit <commit-hash>
#   echo "prepend this" | git-reword-commit <commit-hash> --prepend
#   echo "append this" | git-reword-commit <commit-hash> --append
#   ... | git-reword-commit <commit-hash> --rewrite-published
#
# Examples:
#   # Replace the entire commit message
#   echo "feat: new message here" | git-reword-commit abc123
#
#   # Prepend to existing message (adds newline between)
#   cat msg.txt | git-reword-commit abc123 --prepend
#
#   # Append to existing message (adds newline between)
#   echo "Co-authored-by: Someone" | git-reword-commit abc123 --append
#
# The commit is rebuilt with `git commit-tree` from its own tree, parents, author and
# committer, and so is every commit between it and HEAD that descends from it; nothing else
# changes. HEAD -- a branch, or a detached HEAD -- moves once, with `git update-ref`, and only
# if it still names the commit it named when the rewrite began. The trees are the same, so the
# worktree and index are untouched, and no backup ref is left behind.
#
# A commit any remote-tracking ref already holds is published: rewriting it forks history
# others have. That is refused unless --rewrite-published says it is meant.
#

set -euo pipefail

usage() {
  echo "Usage: <message> | git-reword-commit <commit-hash> [--prepend|--append] [--rewrite-published]"
  echo ""
  echo "Reads new commit message from stdin."
  echo ""
  echo "Modes:"
  echo "  (default)            Replace the entire commit message"
  echo "  --prepend            Prepend to existing message (adds newline between)"
  echo "  --append             Append to existing message (adds newline between)"
  echo "  --rewrite-published  Rewrite even though a remote-tracking ref holds the commit"
  exit 1
}

if [ $# -lt 1 ]; then
  usage
fi

COMMIT_SHORT="$1"
shift

COMMIT_FULL=$(git rev-parse --verify --quiet "$COMMIT_SHORT^{commit}") || {
  echo "Error: Invalid commit reference: $COMMIT_SHORT" >&2
  exit 1
}

MODE="replace"
REWRITE_PUBLISHED=0
for option in "$@"; do
  case "$option" in
    --prepend) MODE="prepend" ;;
    --append) MODE="append" ;;
    --rewrite-published) REWRITE_PUBLISHED=1 ;;
    *)
      echo "Error: Unknown option: $option" >&2
      usage
      ;;
  esac
done

HEAD_BEFORE=$(git rev-parse --verify HEAD)
if ! git merge-base --is-ancestor "$COMMIT_FULL" "$HEAD_BEFORE"; then
  echo "Error: $COMMIT_SHORT is not an ancestor of HEAD; there is nothing of it to rewrite here" >&2
  exit 1
fi

PUBLISHED=$(git for-each-ref --contains "$COMMIT_FULL" --format='%(refname)' refs/remotes)
if [ -n "$PUBLISHED" ] && [ "$REWRITE_PUBLISHED" -ne 1 ]; then
  echo "Error: $COMMIT_SHORT is already published; these remote-tracking refs hold it:" >&2
  printf '  %s\n' $PUBLISHED >&2
  echo "Rewriting it forks history others have. Pass --rewrite-published if that is meant." >&2
  exit 1
fi

WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT
cat > "$WORK/new"
if [ ! -s "$WORK/new" ]; then
  echo "Error: Message cannot be empty (nothing on stdin)" >&2
  usage
fi

# The message bytes of commit $1: everything after the header's terminating blank line.
# Continuation lines of a multi-line header (a signature) start with a space, never empty.
message_of() {
  git cat-file commit "$1" | sed '1,/^$/d'
}

case "$MODE" in
  replace) cp "$WORK/new" "$WORK/message" ;;
  prepend) { cat "$WORK/new"; echo ''; echo ''; message_of "$COMMIT_FULL"; } > "$WORK/message" ;;
  append) { message_of "$COMMIT_FULL"; echo ''; echo ''; cat "$WORK/new"; } > "$WORK/message" ;;
esac

# old -> new for every rebuilt commit, one "old new" pair per line; a parent not listed is kept.
: > "$WORK/map"
rebuilt() {
  awk -v old="$1" '$1 == old { print $2; found = 1 } END { if (!found) print old }' "$WORK/map"
}

# Rebuild $1 on its rebuilt parents with the message in file $2, keeping tree, author and
# committer.
rebuild() {
  local commit="$1" message="$2" parents=() parent listed
  listed=$(git rev-parse "$commit^@")
  for parent in $listed; do
    parents+=(-p "$(rebuilt "$parent")")
  done
  local an ae ad cn ce cd
  {
    IFS= read -r an
    IFS= read -r ae
    IFS= read -r ad
    IFS= read -r cn
    IFS= read -r ce
    IFS= read -r cd
  } < <(git log --no-walk --format='%an%n%ae%n%ad%n%cn%n%ce%n%cd' --date=raw "$commit")
  GIT_AUTHOR_NAME="$an" GIT_AUTHOR_EMAIL="$ae" GIT_AUTHOR_DATE="$ad" \
    GIT_COMMITTER_NAME="$cn" GIT_COMMITTER_EMAIL="$ce" GIT_COMMITTER_DATE="$cd" \
    git commit-tree "$commit^{tree}" ${parents[@]+"${parents[@]}"} < "$message"
}

echo "Rewriting commit $COMMIT_SHORT ($MODE mode)..."

NEW_COMMIT=$(rebuild "$COMMIT_FULL" "$WORK/message")
echo "$COMMIT_FULL $NEW_COMMIT" >> "$WORK/map"
DESCENDANTS=$(git rev-list --reverse --topo-order --ancestry-path "$COMMIT_FULL..$HEAD_BEFORE")
for descendant in $DESCENDANTS; do
  message_of "$descendant" > "$WORK/descendant"
  rebuilt_descendant=$(rebuild "$descendant" "$WORK/descendant")
  echo "$descendant $rebuilt_descendant" >> "$WORK/map"
done

HEAD_AFTER=$(rebuilt "$HEAD_BEFORE")
git update-ref -m "git-reword-commit: reword $COMMIT_FULL" HEAD "$HEAD_AFTER" "$HEAD_BEFORE"

echo "Done. Commit message rewritten."
echo ""
echo "New commit: $NEW_COMMIT"
echo "New HEAD:   $HEAD_AFTER"
