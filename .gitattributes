# Runtime version pins (nvfetcher output). On any merge — especially the mirror
# sync's `git am --3way` — keep whichever side pins the NEWER version instead of
# stalling on a conflict. Driver: tooling/direnv/nixpkgs-overlay/merge-newer.sh,
# defined in tooling/workspace.gitconfig ([merge "nvfetcher-newer"]).
tooling/direnv/nixpkgs-overlay/_sources/generated.json  merge=nvfetcher-newer
tooling/direnv/nixpkgs-overlay/_sources/generated.nix   merge=nvfetcher-newer
