# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
*.tsbuildinfo
dist
tmp
out-tsc

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
.stryker-tmp
stryker-report.html
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

# Local environment overrides
.envrc-local

# Nx
.nx/cache
.nx/workspace-data
.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md
.github/instructions/copilot-instructions.md

# Vite
vite.config.*.timestamp*
vitest.config.*.timestamp*
/.playwright-mcp

# Storybook build output (spec 14 §Storybook adoption — stories run as tests; a static build is never committed)
storybook-static/

# Example
privpkgs/example/.tamagui/tamagui.config.cjs
privpkgs/example/.tamagui/tamagui.config.json


# Private keys must never enter the repo
*.pem

# CodeGraph local index — per-machine, not shared
.codegraph/

# wrangler dev local state — per-machine, not shared
.wrangler/
