# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
*.tsbuildinfo
dist
tmp
out-tsc

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
# per-package Vitest coverage output (A91 shell gate runs)
coverage/
.stryker-tmp
stryker-report.html
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

# Local environment overrides
.envrc-local

# Nx
.nx/cache
.nx/workspace-data
# Transient esbuild bundles for the workerd test harnesses
.nx/conformance
.nx/auth-e2e
.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md
.github/instructions/copilot-instructions.md

# Vite
vite.config.*.timestamp*
vitest.config.*.timestamp*
/.playwright-mcp

# Storybook build output (spec 14 §Storybook adoption — stories run as tests; a static build is never committed)
storybook-static/

# Example
privpkgs/example/.tamagui/tamagui.config.cjs
privpkgs/example/.tamagui/tamagui.config.json

# Agents & MCPs
.claude/worktrees
.serena/
.token-savior-cache.json


# MCP server artifacts (never commit)
.serena/
.token-savior-cache.json

# Jcode temporary nested worktrees
.jcode-worktrees/

# Agent tooling (ralphex, haft, MCP config)
/.ralphex
/.haft
.mcp.json

# Private keys must never enter the repo (GitHub App etc.)
*.pem

# CodeGraph local index — per-machine, not shared
.codegraph/

# wrangler dev local state — per-machine, not shared
.wrangler/
# E2E harness env — contains the App webhook secret; never commit
e2e/.env.staging
e2e/.env.*

# git-crypt symmetric key for e2e/secrets (export via `git-crypt export-key`; never commit)
e2e-git-crypt.key
**/e2e-git-crypt.key

# wrangler: local secret values (names live in .dev.vars.example, committed)
.dev.vars
!.dev.vars.example
worker-configuration.d.ts
