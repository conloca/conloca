diff --git a/node_modules/ttsc/src/plugin/internal/prepareTypeScriptGoSource.ts b/src/plugin/internal/prepareTypeScriptGoSource.ts
new file mode 100644
index 0000000000000000000000000000000000000000..6036663c2b5b81194bc46641b2ac37c083978732
--- /dev/null
+++ b/src/plugin/internal/prepareTypeScriptGoSource.ts
@@ -0,0 +1,66 @@
+import crypto from "node:crypto";
+import fs from "node:fs";
+import path from "node:path";
+
+const MODULE = "github.com/microsoft/typescript-go";
+const VERSION = "v0.0.0-20260429010842-56ab4af42157";
+const SOURCE_SHA256 = "dc70cd1b719895c1df583e23755b85081d3d9979d16933e4c2732b98b4563603";
+
+/** Compile the pinned reference-walker fix without modifying Go's module cache. */
+export function prepareTypeScriptGoSource(
+  cwd: string,
+  query: (args: readonly string[]) => string,
+): void {
+  const pinned = process.env.TTSC_TYPESCRIPT_GO_DIR;
+  const [version, directory, replacement] = pinned
+    ? [VERSION, pinned, undefined]
+    : query([
+        "list", "-m", "-f", "{{.Version}}\n{{.Dir}}\n{{if .Replace}}replaced{{end}}", MODULE,
+      ]).trim().split(/\r?\n/);
+  if (version !== VERSION || !directory || replacement) {
+    throw new Error(`ttsc: native compiler patch requires ${MODULE}@${VERSION}; resolved ${version} at ${directory}${replacement ? " (replaced)" : ""}`);
+  }
+  const original = path.join(directory, "internal", "checker", "emitresolver.go");
+  if (crypto.createHash("sha256").update(fs.readFileSync(original)).digest("hex") !== SOURCE_SHA256) {
+    throw new Error(`ttsc: native compiler source patch rejected unexpected contents of ${original}; expected SHA-256 ${SOURCE_SHA256}`);
+  }
+
+  // Go forbids -overlay beneath GOMODCACHE. A scratch workspace replacement
+  // compiles the real upstream sources with one corrected file, without changing
+  // the caller's GOFLAGS or overwriting a caller-provided source overlay.
+  const destination = path.join(cwd, ".ttsc-typescript-go");
+  fs.mkdirSync(destination);
+  for (const file of ["go.mod", "go.sum"]) {
+    fs.copyFileSync(path.join(directory, file), path.join(destination, file));
+  }
+  // The pinned module's production packages and embedded standard libraries all
+  // live in internal/. Its testdata and repository tooling are not build inputs.
+  copyCompilerDirectory(path.join(directory, "internal"), path.join(destination, "internal"), original);
+  fs.copyFileSync(
+    path.resolve(__dirname, "../../../shim/checker/upstream-emitresolver.go.txt"),
+    path.join(destination, "internal", "checker", "emitresolver.go"),
+  );
+  query(["work", "edit", `-replace=${MODULE}=${destination}`]);
+}
+
+function copyCompilerDirectory(source: string, destination: string, replacedFile: string): void {
+  // Module-cache directories are read-only. Create writable scratch directories
+  // so the patched file can be installed and normal scratch cleanup can unlink it.
+  fs.mkdirSync(destination);
+  for (const entry of fs.readdirSync(source, { withFileTypes: true })) {
+    const from = path.join(source, entry.name);
+    const to = path.join(destination, entry.name);
+    if (from === replacedFile) continue;
+    if (entry.isDirectory()) copyCompilerDirectory(from, to, replacedFile);
+    else if (entry.isFile()) copyFileForScratch(from, to);
+    else throw new Error(`ttsc: unsupported entry in native compiler source: ${from}`);
+  }
+}
+
+function copyFileForScratch(from: string, to: string): void {
+  try {
+    fs.copyFileSync(from, to, fs.constants.COPYFILE_FICLONE);
+  } catch {
+    fs.copyFileSync(from, to);
+  }
+}
