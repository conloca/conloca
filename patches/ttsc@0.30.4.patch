@@ -0,0 +1,72 @@
+package driver
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	shimast "github.com/microsoft/typescript-go/shim/ast"
+	shimcompiler "github.com/microsoft/typescript-go/shim/compiler"
+	shimprinter "github.com/microsoft/typescript-go/shim/printer"
+)
+
+func TestEmitMetaPropertiesRemainSyntax(t *testing.T) {
+	for _, declarations := range []bool{false, true} {
+		t.Run(fmt.Sprintf("declarations=%v", declarations), func(t *testing.T) {
+			root, err := filepath.EvalSymlinks(t.TempDir())
+			if err != nil {
+				t.Fatal(err)
+			}
+			files := map[string]string{
+				"tsconfig.json": fmt.Sprintf(`{"compilerOptions":{"target":"ES2022","module":"ESNext","moduleResolution":"Bundler","types":[],"lib":["ES2022","DOM"],"strict":true,"noEmitOnError":true,"outDir":"out","declaration":%v,"sourceMap":true},"files":["index.ts","dependency.ts"]}`, declarations),
+				"dependency.ts": `export const value = 7;`,
+				"index.ts": `import { value } from "./dependency.js";
+export const result = value;
+export const url = new URL("./asset", import.meta.url).href;
+export function Constructor() { return new.target; }
+`,
+			}
+			for name, text := range files {
+				if err := os.WriteFile(filepath.Join(root, name), []byte(text), 0o644); err != nil {
+					t.Fatal(err)
+				}
+			}
+			program, diagnostics, err := LoadProgram(root, "tsconfig.json", LoadProgramOptions{})
+			if err != nil || CountErrors(diagnostics) != 0 {
+				t.Fatalf("load failed: %v; %v", err, diagnostics)
+			}
+			defer program.Close()
+			if diagnostics := program.Diagnostics(); CountErrors(diagnostics) != 0 {
+				t.Fatalf("valid ESM failed checking: %v", diagnostics)
+			}
+			output := make(map[string]string)
+			diagnostics, err = program.EmitWithPluginTransformer(
+				func(_ *shimprinter.EmitContext, source *shimast.SourceFile) *shimast.SourceFile { return source },
+				func(name, text string, _ *shimcompiler.WriteFileData) error {
+					output[filepath.Base(name)] = text
+					return nil
+				},
+			)
+			if err != nil || CountErrors(diagnostics) != 0 {
+				t.Fatalf("valid ESM failed native plugin emission: %v; %v", err, diagnostics)
+			}
+			if diagnostics := program.Diagnostics(); CountErrors(diagnostics) != 0 {
+				t.Fatalf("emit introduced semantic errors: %v", diagnostics)
+			}
+			js := output["index.js"]
+			for _, expression := range []string{"import.meta.url", "new.target", `from "./dependency.js"`} {
+				if !strings.Contains(js, expression) {
+					t.Fatalf("missing runtime expression %q in emitted JavaScript:\n%s", expression, js)
+				}
+			}
+			if _, ok := output["index.js.map"]; !ok {
+				t.Fatal("source map was not emitted")
+			}
+			if declarations && !strings.Contains(output["index.d.ts"], "export declare const url: string;") {
+				t.Fatalf("missing public declaration: %s", output["index.d.ts"])
+			}
+		})
+	}
+}
