+
+// SourceMapGenerator is the generator the printer records positions into
+// (internal/sourcemap.Generator), and NewSourceMapGenerator starts one for
+// the generated file named file; RawSourceMap is its decoded form. Exposed
+// here rather than as a shim module of their own so the shim tree gains no
+// directory.
+type SourceMapGenerator = sourcemap.Generator
+type RawSourceMap = sourcemap.RawSourceMap
+
+func NewSourceMapGenerator(file string, sourceRoot string, sourcesDirectoryPath string) *SourceMapGenerator {
+	return sourcemap.NewGenerator(file, sourceRoot, sourcesDirectoryPath, tspath.ComparePathsOptions{})
+}
+
+// EmitSourceFileWithSourceMap renders the full source file and records every
+// mapped position into generator, returning the emitted text.
+func EmitSourceFileWithSourceMap(p *Printer, sourceFile *ast.SourceFile, generator *SourceMapGenerator) string {
+	writer := NewTextWriter(p.Options.NewLine.GetNewLineCharacter(), 0)
+	p.Write(sourceFile.AsNode(), sourceFile, writer, generator)
+	return writer.String()
+}
