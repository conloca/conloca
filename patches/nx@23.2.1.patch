+                    throw new Error(`Recursive task output lease: client ${process.pid} cannot acquire ${targets.join(", ")} while ancestor client ${ancestor.parentPid} runs ${ancestor.taskId}; invocation chain: ${chain.map((record) => record.taskId).join(" -> ")}`);
