+import { Task } from '../config/task-graph';
+import { TaskInvocationTracker } from '../native';
+/** A target's cross-client ownership from cache lookup/restore through execution and cache capture. */
+export declare class TaskOutputLeases {
+    constructor(parallelism: number, invocationTracker: TaskInvocationTracker | null, purpose: 'output' | 'continuous-startup');
+    acquire(tasks: readonly Task[]): Promise<() => Promise<void>>;
+    withTasks<T>(tasks: readonly Task[], action: () => Promise<T>): Promise<T>;
+    cancelPending(): Promise<void>;
+    close(): Promise<void>;
+}
