+                    // helper holds only kernel leases, never task work.
+                    entry.worker.kill("SIGKILL");
+                    return entry.exited;
+                }));
+        }
+        async close() {
+            await this.cancelPending();
+            this.closed = true;
+            await Promise.all([...this.children].map((entry) => {
+                entry.worker.kill("SIGKILL");
+                return entry.exited;
+            }));
+            this.idle.length = 0;
+        }
+    }
+    exports.TaskOutputLeases = TaskOutputLeases;
+}
