+                this.retire(entry, new Error(`Task output lease worker exited (code ${code}, signal ${signal ?? "none"}) for ${entry.targets.join(", ")} at ${entry.paths.join(", ")}`));
+                gone();
+            });
+            return entry;
+        }
+        // Takes a helper that no longer serves out of the pool, once: its
+        // pending exchange fails with the reason, and its slot goes to the
+        // oldest waiter, which forks a successor.
+        retire(entry, error) {
+            if (entry.retired) return;
+            entry.retired = true;
+            entry.failed ??= error;
+            entry.pending?.reject(entry.failed);
+            entry.pending = null;
+            // A live helper that stopped serving holds no lease: its error reply unlocked them, or a failed send left
+            // it unreachable. Killing it releases whatever the kernel still records.
+            entry.worker.kill("SIGKILL");
+            this.workers.delete(entry);
+            const index = this.idle.indexOf(entry);
+            if (index !== -1) this.idle.splice(index, 1);
+            const waiter = this.waiters.shift();
+            if (waiter) {
+                this.reserved++;
+                waiter.resolve(null);
+            }
+        }
+        exchange(entry, message) {
+            if (entry.failed) return Promise.reject(entry.failed);
+            return new Promise((resolve, reject) => {
+                entry.pending = { resolve, reject };
+                entry.worker.send(message, (error) => {
+                    if (error) this.retire(entry, new Error(`Task output lease helper for ${entry.targets.join(", ")} at ${entry.paths.join(", ")} could not be sent ${message.type}`, { cause: error }));
+                });
+            });
+        }
+        async withTasks(tasks, action) {
+            const release = await this.acquire(tasks);
+            try {
+                return await action();
+            }
+            finally {
+                await release();
+            }
+        }
+        async cancelPending() {
+            this.stopping = true;
+            for (const waiter of this.waiters.splice(0)) {
+                waiter.reject(new Error("Task output lease acquisition cancelled during runner cleanup"));
+            }
+            await Promise.all([...this.workers]
+                .filter((entry) => entry.phase === "acquiring")
+                .map((entry) => {
