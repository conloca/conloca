+            }
+            if (this.stopping) {
+                throw new Error(`Cannot acquire task output lease after disposal: ${targets.join(", ")}`);
+            }
+            // Detect an ancestor that owns the same output before blocking.
+            // Configurations share a lease even when their full task ids differ.
+            if (this.invocationTracker && Number(process.env.NX_INVOCATION_ROOT_PID ?? process.pid) !== process.pid) {
