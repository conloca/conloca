+const { channel } = require("node:diagnostics_channel");
+const { writeFileSync } = require("node:fs");
+const { join } = require("node:path");
+const { fork } = require("node:child_process");
+const { FileLock, hashArray } = require("../native");
+const { workspaceDataDirectory } = require("../utils/cache-directory");
+const events = channel("nx:task-output-lease");
+
+// FileLock.lock() is synchronous. Reusable helper processes keep a contended
+// lock off the client's event loop. Unlike a worker thread inside a blocking
+// native call, a helper can be cancelled immediately by the kernel. Persistent
+// lock files are never unlinked or replaced.
+if (process.argv[2] === "--nx-task-output-lease-worker") {
+    let held = [];
+    // One FileLock, so one descriptor, per lock file for the helper's life:
+    // FileLock has no close, and a fresh one per acquire kept every descriptor
+    // until garbage collection.
+    const locks = new Map();
+    process.on("disconnect", () => process.exit(0));
+    process.on("message", (message) => {
+        try {
+            if (message.type === "acquire") {
+                for (const path of message.paths) {
+                    let lock = locks.get(path);
+                    if (!lock) {
+                        lock = new FileLock(path);
+                        locks.set(path, lock);
+                    }
+                    lock.lock();
+                    held.push({ lock, path });
+                    writeFileSync(path, JSON.stringify({ pid: process.pid, clientPid: process.ppid, purpose: message.purpose, targets: message.targets }));
+                }
+                process.send({ type: "acquired" });
+            }
+            else if (message.type === "release") {
+                for (const { lock, path } of held.reverse()) {
+                    writeFileSync(path, "");
+                    lock.unlock();
+                }
+                held = [];
+                process.send({ type: "released" });
+            }
+        }
+        catch (error) {
+            for (const { lock } of held.reverse()) {
+                lock.unlock();
+            }
+            held = [];
+            process.send({ type: "error", message: error.message, stack: error.stack });
+        }
+    });
+}
+else {
