# Managed by smoo. This shell is built from this checkout's inputs alone: no
# parent directory's .envrc is sourced, so the same commit enters the same shell
# wherever it is checked out. Project additions belong in .envrc-local
# (gitignored); shell logic belongs in tooling/direnv/devenv.nix.

# devenv lives in tooling/direnv. It is the one tool this file needs from the
# host; everything else comes from the shell it evaluates. The directory stack,
# not `cd ../..`, brings this file back: the export `use devenv` replays leaves
# the shell wherever the devenv shell hook last changed directory.
if ! has devenv; then
  log_error "devenv is not on PATH: install it (https://devenv.sh/getting-started/), then run direnv reload"
  exit 1
fi
pushd tooling/direnv >/dev/null
eval "$(devenv direnvrc)"
use devenv
popd >/dev/null

# Re-enter after a pull or a dependency edit; devenv's smoo:install and
# smoo:cargo-fetch tasks then decide whether anything installs. The scripts
# shell entry runs are not inputs devenv evaluates, so a change to one
# re-enters through this watch too.
watch_file \
  package.json bun.lock uv.lock Cargo.lock \
  tooling/direnv/nixpkgs-overlay/flake.nix \
  tooling/direnv/nixpkgs-overlay/_sources/generated.nix \
  tooling/direnv/repo-path \
  tooling/direnv/nx-socket-dir.sh \
  tooling/direnv/ttsc-env.sh \
  tooling/direnv/apple-developer.sh \
  tooling/direnv/setup-environment.ts \
  tooling/direnv/secret-references.ts \
  tooling/direnv/toolchain-stamp.ts

# A cowshed workspace's environment, for interactive shells inside one; an
# absent file is skipped.
source_env_if_exists .cowshed/env
source_env_if_exists .envrc-local
