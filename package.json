{
  "name": "@conloca/source",
  "version": "0.0.0",
  "license": "FSL-1.1-ALv2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conloca/conloca.git"
  },
  "scripts": {
    "build:all": "nx run-many -t build",
    "check:linux": "tooling/devenv -P linux-cross shell -- nx run-many -t cargo-lint-cross",
    "clean": "nx run-many -t clean; nx reset",
    "clean:ignored": "git clean -dfX -- packages/* targets/* && find packages targets -depth -mindepth 1 -type d -empty -delete",
    "clean:node_modules": "rm -rf node_modules && find e* t* p* -type d -name node_modules -print0 | xargs -0 rm -rvf",
    "dev:conloca": "nx run website-with-cms:dev --outputStyle=dynamic-legacy",
    "dev:website": "nx run conloca-website:dev --outputStyle=dynamic-legacy",
    "format:changed": "git-format-staged --config tooling/git-hooks/git-format-staged.yml --also-unstaged",
    "format:staged": "git-format-staged --config tooling/git-hooks/git-format-staged.yml",
    "lint": "nx run-many -t lint",
    "lint:fix": "git-format-staged --config tooling/git-hooks/git-format-staged.yml --unstaged",
    "list:nx-build-targets": "nx show projects | xargs -n1 nx show project --json | jq -r  '.name as $name | .targets | to_entries[] | \"\\($name):\\(.key)\"'",
    "pack:all": "bun tooling/sync-lockfile-versions.ts && for p in $(nx show projects | grep '^@conloca/'); do echo \"Packing $p\"; (cd $(nx show project $p --json | jq -r .root) && bun pm pack); done",
    "release:build": "nx run-many -t build --projects=@conloca/astro-cms,@conloca/cms-spa,@conloca/content-api,@conloca/content-api-client,@conloca/cli,@conloca/mdx",
    "release:changelog": "nx release changelog --projects=@conloca/astro-cms,@conloca/cms-spa,@conloca/content-api,@conloca/content-api-client,@conloca/cli,@conloca/mdx",
    "release:projects:list": "nx show projects | grep '^@conloca/'",
    "release:publish": "bun tooling/sync-lockfile-versions.ts && nx release publish --projects=@conloca/astro-cms,@conloca/cms-spa,@conloca/content-api,@conloca/content-api-client,@conloca/cli,@conloca/mdx",
    "release:publish:dry": "bun tooling/sync-lockfile-versions.ts && nx release publish --projects=@conloca/astro-cms,@conloca/cms-spa,@conloca/content-api,@conloca/content-api-client,@conloca/cli,@conloca/mdx --dryRun",
    "release:sync-lockfile": "bun tooling/sync-lockfile-versions.ts",
    "reload:direnv": "rm -rf tooling/direnv/.{direnv,devenv}; direnv reload",
    "reload:node_modules": "tooling/rm_node_modules; bun install",
    "show:tree": "tree --gitignore -d",
    "syncpack:fix": "bunx syncpack fix-mismatches",
    "update:devenv": "cd tooling/direnv; devenv update",
    "update:npm:interactive": "bun update --interactive --recursive"
  },
  "private": true,
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=26.0.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-react": "^8.0.1",
    "@biomejs/biome": "^2.5.14",
    "@conloca/content-api": "workspace:*",
    "@conloca/tooling": "workspace:*",
    "@nx/js": "23.2.1",
    "@nx/react": "23.2.1",
    "@nx/web": "23.2.1",
    "@nx/workspace": "23.2.1",
    "@oxlint/plugins": "1.85.0",
    "@smoothbricks/cowshed": "^0.3.0",
    "@smoothbricks/nx-plugin": "^0.5.7",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "^16.3.3",
    "@ttsc/unplugin": "^0.30.4",
    "@types/bun": "1.4.2",
    "@types/node": "^26.6.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@typescript-eslint/parser": "^8.69.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "ajv": "^8.20.0",
    "eslint": "^10.9.1",
    "eslint-plugin-astro": "^3.1.0",
    "eslint-stdout": "^1.1.2",
    "jiti": "2.7.0",
    "jsdom": "^30.0.1",
    "nx": "23.2.1",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2003",
    "prettier": "^3.9.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "^7.18.3",
    "tslib": "^2.8.1",
    "ttsc": "0.30.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "verdaccio": "6.10.4",
    "vite": "^7.3.6",
    "vitest": "^4.1.11",
    "wrangler": "^4.128.0"
  },
  "workspaces": [
    "packages/*",
    "example/*",
    "targets/*",
    "tooling"
  ],
  "nx": {
    "includedScripts": [],
    "targets": {
      "local-registry": {
        "executor": "@nx/js:verdaccio",
        "options": {
          "port": 4873,
          "config": ".verdaccio/config.yml",
          "storage": "tmp/local-registry/storage"
        }
      }
    },
    "name": "@conloca/source"
  },
  "overrides": {
    "typia": "14.0.6",
    "brace-expansion": "5.0.12",
    "@verdaccio/config>js-yaml": "5.4.2",
    "@mdxeditor/editor@3>js-yaml": "4.3.2",
    "nx>smol-toml": "1.8.0",
    "typed-rest-client>qs": "6.16.0",
    "nx>axios": "1.20.0",
    "sharp": "0.35.5",
    "miniflare>undici": "7.29.1",
    "verdaccio>compression": "1.8.2",
    "http-cache-semantics": "4.3.0",
    "solid-js>seroval": "1.6.3",
    "solid-js>seroval-plugins": "1.6.3",
    "source-map-js": "1.2.2",
    "@verdaccio/hooks>handlebars": "4.7.10",
    "nx": "23.2.1"
  },
  "patchedDependencies": {
    "ttsc@0.30.4": "patches/ttsc@0.30.4.patch",
    "@ttsc/unplugin@0.30.4": "patches/@ttsc%2Funplugin@0.30.4.patch",
    "nx@23.2.1": "patches/nx@23.2.1.patch"
  },
  "sherif": {
    "ignoreDependency": [
      "vite@^8.2.2"
    ],
    "ignorePackage": [
      "conloca-website"
    ]
  }
}
